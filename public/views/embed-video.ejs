        </div>
        <video id="video-player" class="video-player"></video>
      </div>
    </div>
    <script>
      const INCOMING_PARAMETERS = <%- JSON.stringify(model).replace(/</g, '\\u003c') %>;

      async function copyVideoLink(text) {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const input = document.createElement('textarea');
          input.value = text;
          input.style.cssText = 'position:absolute;left:-1000px;top:-1000px';
          (document.fullscreenElement || document.body).append(input);
          input.select();
          document.execCommand('copy');
          input.remove();
        }
      }

      async function initializeEmbeddedVideo() {
        const videoId = window.location.pathname.split('/')[4];
        if (!videoId) return;
        const parameters = new URL(window.location.href).searchParams;
        const video = INCOMING_PARAMETERS.videoData.video;
        const videoUrl = new URL('/watch', window.location.origin);
        videoUrl.searchParams.set('v', videoId);
        document.title = video.title + ' - MoarTube';
        document.getElementById('mtp-video-title').textContent = video.title;
        for (const id of ['mtp-video-link', 'watch-on-moartube-mtp-overlay-child']) {
          const link = document.getElementById(id);
          link.href = videoUrl.href;
          link.rel = 'noopener';
        }
        document.getElementById('mtp-channel-link').rel = 'noopener';
        document.getElementById('video-poster').src = INCOMING_PARAMETERS.externalVideosBaseUrl + '/external/videos/' + encodeURIComponent(videoId) + '/images/poster.jpg';
        if (video.isLive) {
          const badge = document.createElement('span');
          badge.id = 'live-stream-indicator';
          badge.textContent = video.isStreaming ? 'LIVE' : 'STREAMED';
          document.getElementById('mtp-video-overlay').append(badge);
        }
        let message = '';
        if (video.adaptiveSources.length || video.progressiveSources.length) {
          if (!video.isPublished && !video.isStreaming) {
            message = video.isStreamed ? 'this live stream has ended and has not been published' : 'this video is unavailable';
          }
        } else if (video.isPublishing) {
          message = 'this video is currently publishing, please check back later';
        } else if (video.isStreaming) {
          message = 'this live stream has not started yet';
        } else {
          message = video.isStreamed ? 'this live stream has ended and has not been published' : 'this video is unavailable';
        }
        if (message) {
          document.getElementById('mtp-video-overlay').remove();
          const notice = document.createElement('div');
          notice.className = 'mt-embed-message';
          notice.setAttribute('role', 'status');
          notice.textContent = message;
          document.getElementById('video-player-container').append(notice);
          return;
        }
        try {
          const { createVideoPlayer } = await import(INCOMING_PARAMETERS.externalResourcesBaseUrl + '/external/resources/javascript/videojs-10.2.0.js');
          createVideoPlayer({
            placeholder: document.getElementById('video-player'),
            adaptiveSources: video.adaptiveSources,
            progressiveSources: video.progressiveSources,
            isStreaming: video.isStreaming,
            timeParameter: parameters.get('t'),
            videoId,
            embedded: true,
            autoStart: Boolean(Number(parameters.get('autostart'))),
            copyText: copyVideoLink,
          });
        } catch (error) {
          console.error('Unable to initialize embedded video player', error);
          document.getElementById('mtp-video-overlay').classList.add('hidden-elem');
          const notice = document.createElement('div');
          notice.className = 'mt-embed-message';
          notice.setAttribute('role', 'alert');
          notice.textContent = 'Unable to load the video player. Please reload the page.';
          document.getElementById('video-player-container').append(notice);
        }
      }

      void initializeEmbeddedVideo();
    </script>
  </body>
</html>
