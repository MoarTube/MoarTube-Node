<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MoarTube</title>
    <link
      rel="icon"
      type="image/x-icon"
      href="<%=model.externalResourcesBaseUrl%>/external/resources/images/favicon.ico"
    />
    <link
      href="<%=model.externalResourcesBaseUrl%>/external/resources/css/videojs-10.2.0.css"
      rel="stylesheet"
      type="text/css"
    />
    <link
      href="<%=model.externalResourcesBaseUrl%>/external/resources/css/bootstrap.min-5.3.0.css"
      rel="stylesheet"
      type="text/css"
    />
    <style>
      html, body, #video-comments-inner { width: 100%; height: 100%; margin: 0; padding: 0; background: #000; font-family: Arial, sans-serif; }
      #video-player-container { position: relative; width: 100%; height: 100%; background: #000; color: #fff; }
      .hidden-elem { display: none !important; }
      #mtp-video-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
      .mtp-video-overlay-child { position: absolute; inset: 0; pointer-events: none; }
      .mtp-video-overlay-child a, .mtp-large-play-button { pointer-events: auto; }
      #video-poster { width: 100%; height: 100%; object-fit: contain; }
      .mtp-large-play-button { position: absolute; width: 68px; height: 48px; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 1; }
      .mtp-large-play-button svg { display: block; width: 100%; height: 100%; pointer-events: none; }
      .mtp-button { border: none; padding: 0; color: inherit; background: transparent; cursor: pointer; }
      #mtp-video-title { color: #fff; font-size: 18px; }
      .mpt-video-icon { width: 40px; height: 40px; border-radius: 50%; }
      #live-stream-indicator { position: absolute; right: 5px; bottom: 5px; z-index: 2; border-radius: 4px; padding: 3px; background: #cb0c9f; color: #fff; font-size: 11px; }
      .mt-embed-message { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; text-align: center; }
    </style>
  </head>

  <body class="overflow-hidden">
    <div id="video-comments-inner">
      <div
        id="video-player-container"
        class="mt-embed-container"
      >
        <div
          id="mtp-video-overlay-info"
          class="p-2 d-flex align-items-center"
          style="height: auto; background: #0000007a"
        >
          <a id="mtp-channel-link" class="text-decoration-none me-2" href="/" target="_blank">
            <img
              class="mpt-video-icon"
              alt="MoarTube channel"
              src="<%=model.externalResourcesBaseUrl%>/external/resources/images/icon.png"
            />
          </a>
          <a
            id="mtp-video-link"
            class="text-decoration-none text-truncate"
            target="_blank"
            style="max-width: 100%"
          >
            <div id="mtp-video-title" class="d-inline-block"></div>
          </a>
        </div>
        <div
          id="mtp-video-overlay"
          class="mt-embed-poster"
          role="button"
        >
          <div id="big-play-button-poster-container" class="mtp-video-overlay-child">
            <button class="mtp-button mtp-large-play-button">
