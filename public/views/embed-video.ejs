                <path d="M 51.908 24 L 33.908 14 L 33.908 34" fill="#fff"></path>
                <path d="M 37.342 24.211 L 19.342 14.211 L 19.342 34.211" fill="#fff"></path>
              </svg>
            </button>
            <img id="video-poster" alt="" />
          </div>
