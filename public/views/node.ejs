    <div class="container-fluid p-0 mt-2">
      <div class="row m-0">
        <div class="col-12 p-0">
          <img
            class="img-fluid"
            src="<%=model.externalResourcesBaseUrl%>/external/resources/images/banner.png"
          />
        </div>
      </div>
      <div class="container">
        <div
          class="row m-0 pt-3 align-items-center justify-content-center align-items-sm-start justify-content-sm-start"
        >
          <div class="col-auto p-0 text-end">
            <img
              id="node-avatar"
              class="img-fluid"
              src="<%=model.externalResourcesBaseUrl%>/external/resources/images/avatar.png"
            />
          </div>
          <div id="node-information" class="col-auto p-0">
            <div class="container-fluid mt-2 p-0">
              <div class="row m-0">
                <h2><span id="node-name" class="text-break">........</span></h2>
                <h2><span id="node-headline" class="text-break">........</span></h2>
              </div>
              <div class="row m-0">
                <h5><span id="node-video-count" class="text-break">........</span></h5>
              </div>
              <div class="row m-0">
                <span id="node-about" class="text-break">........</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <hr />
      <div id="sort-buttons" class="container p-0 mt-2">
        <button
          id="sort-button-latest"
          type="button"
          class="btn btn-outline-primary sort-button content-button"
          data-sortterm="latest"
          style="white-space: nowrap"
        >
          latest
        </button>
        <button
          id="sort-button-popular"
          type="button"
          class="btn btn-outline-primary sort-button content-button"
          data-sortterm="popular"
          style="white-space: nowrap"
        >
          popular
        </button>
        <button
          id="sort-button-oldest"
          type="button"
          class="btn btn-outline-primary sort-button content-button"
          data-sortterm="oldest"
          style="white-space: nowrap"
        >
          oldest
        </button>
      </div>
      <div id="tag-buttons" class="container p-0 mt-1"></div>
      <div id="search-container" class="input-group container p-0 mt-2">
        <input type="text" id="search-input" class="form-control" placeholder="Search here..." />
      </div>
      <div id="videos-container" aria-busy="false"></div>
      <div id="catalog-sentinel" class="container text-center p-3" style="min-height: 1px">
        <output id="videos-scroller-loading-spinner" class="spinner-border text-primary spinner-md" aria-hidden="true" hidden></output>
        <span id="catalog-status" role="status" aria-live="polite"></span>
      </div>
    </div>
    <div
      class="modal fade"
      id="settingsModal"
      tabindex="-1"
      aria-labelledby="settingsModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="settingsModalLabel">Settings</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="darkModeSwitch" />
              <label class="form-check-label" for="darkModeSwitch">dark mode</label>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/web3@latest/dist/web3.min.js"></script>
    <script src="<%=model.externalResourcesBaseUrl%>/external/resources/javascript/sweetalert-11.0.11.min.js"></script>

    <script>
      this.INCOMING_PARAMETERS = <%- JSON.stringify(model) %>;

      class MoarTubeNode {
      	constructor() {
      		this.INCOMING_PARAMETERS = INCOMING_PARAMETERS;
      		this.CURRENT_SEARCH_TERM = null;
      		this.CURRENT_SORT_TERM = null;
      		this.CURRENT_TAG_TERM = null;
      		this.TIMESTAMP_UPDATE_TRACKER = [];
      		this.CRYPTO_WALLET_ADDRESSES = [];
      		this.EXTERNAL_VIDEOS_BASE_URL = null;
      		this.EXTERNAL_RESOURCES_BASE_URL = null;
      		this.searchInputTimer = null;
          this.catalogGeneration = 0;
          this.catalogRequest = null;
          this.catalogLoading = false;
          this.catalogHasMore = false;
          this.catalogNextOffset = 0;
          this.catalogError = false;
          this.catalogRetryTimer = null;
          this.catalogRetryCount = 0;
          this.catalogGroups = new Map();
      	}

      	init() {
      		const params = new URL(window.location.href).searchParams;

      		let searchTerm = params.get('searchTerm');
      		let sortTerm = params.get('sortTerm');
      		let tagTerm = params.get('tagTerm');

      		if (searchTerm == null) {
      			searchTerm = '';
      		}

      		if (sortTerm == null) {
      			sortTerm = 'latest';
      			$('#sort-button-latest').addClass('content-button-selected');
      		}
      		else if (sortTerm == 'latest') {
      			$('#sort-button-latest').addClass('content-button-selected');
      		}
      		else if (sortTerm == 'popular') {
      			$('#sort-button-popular').addClass('content-button-selected');
      		}
      		else if (sortTerm == 'oldest') {
      			$('#sort-button-oldest').addClass('content-button-selected');
      		}
      		else {
      			sortTerm = 'latest';
      			$('#sort-button-latest').addClass('content-button-selected');
      		}

      		if (tagTerm == null) {
      			tagTerm = '';
      		}

      		this.CURRENT_SEARCH_TERM = searchTerm;
      		this.CURRENT_SORT_TERM = sortTerm;
      		this.CURRENT_TAG_TERM = tagTerm;

      		$('#search-input').val(searchTerm);

      		this.EXTERNAL_VIDEOS_BASE_URL = this.INCOMING_PARAMETERS.externalVideosBaseUrl;
      		this.EXTERNAL_RESOURCES_BASE_URL = this.INCOMING_PARAMETERS.externalResourcesBaseUrl;

      		this.loadInformation(this.INCOMING_PARAMETERS.informationData.information);
      		this.loadLinks(this.INCOMING_PARAMETERS.linksData.links);
      		this.loadCryptoWalletAddresses(this.INCOMING_PARAMETERS.cryptoWalletAddressesData.cryptoWalletAddresses);
      		this.loadTags(this.INCOMING_PARAMETERS.tagsData.tags);
          this.setupInfiniteScroll();
          this.acceptCatalogPage(this.INCOMING_PARAMETERS.searchResultsData);

      		this.setupEventListeners();
      	}

      	setupEventListeners() {
      		$('#navbar-donate-button').off('click').on('click', () => this.donateVideo());
      		$('#navbar-settings-button').off('click').on('click', () => this.showSettings());

      		$('#sort-button-latest').off('click').on('click', () => this.sortButtonClicked(document.getElementById('sort-button-latest')));
      		$('#sort-button-popular').off('click').on('click', () => this.sortButtonClicked(document.getElementById('sort-button-popular')));
      		$('#sort-button-oldest').off('click').on('click', () => this.sortButtonClicked(document.getElementById('sort-button-oldest')));

      		$('#search-input').off('input').on('input', (event) => this.searchInputEntered(event.target));

      		// Tag buttons are dynamically created, so we need to use event delegation
      		$('#tag-buttons').off('click', '.tag-button').on('click', '.tag-button', (event) => {
      			this.tagButtonSelected(event.currentTarget);
      		});
      	}

      	loadInformation(information) {
          const nodeName = information.nodeName;
          const nodeHeadline = information.nodeHeadline;
      		const nodeVideoCount = information.nodeVideoCount;
      		const nodeAbout = information.nodeAbout;

      		const nodeAboutHtml = nodeAbout.replace(/(?:\r\n|\r|\n)/g, '<br>');

      		let nodeVideoCountDescriptor = '';

      		if (nodeVideoCount != 1) {
      			nodeVideoCountDescriptor = ' videos';
      		}
      		else {
      			nodeVideoCountDescriptor = ' video';
      		}

          $('#node-name').text(nodeName);
          $('#node-headline').text(nodeHeadline);
      		$('#node-video-count').text(nodeVideoCount + nodeVideoCountDescriptor);
      		$('#node-about').html(nodeAboutHtml);

          if (nodeName != '') {
            document.title = nodeName + ' - MoarTube';
      		}
      	}

      	loadLinks(links) {
      		for (let i = links.length - 1; i >= 0; i--) {
      			const link = links[i];

      			const url = link.url;
      			const svgGraphic = link.svg_graphic;

      			const html = '\
      				<a href="' + url + '" target="_blank" class="navbar-settings-button navbar-brand" role="button">' + svgGraphic + '</a>';

      			$('#navbar-settings-buttons').prepend(html);
      		}
      	}

      	loadCryptoWalletAddresses(cryptoWalletAddresses) {
      		this.CRYPTO_WALLET_ADDRESSES = cryptoWalletAddresses;
      	}

        loadTags(tags) {
          const container = document.getElementById('tag-buttons');
          for (const tag of ['', ...tags]) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'btn btn-outline-primary tag-button content-button me-1';
            button.dataset.tagterm = tag;
            button.style.whiteSpace = 'nowrap';
            button.textContent = tag || 'all';
            if (tag === this.CURRENT_TAG_TERM) button.classList.add('content-button-selected');
            container.append(button);
          }
        }

        setupInfiniteScroll() {
          this.catalogObserver = new IntersectionObserver(entries => {
            if (entries.some(entry => entry.isIntersecting)) this.loadMoreVideos();
          }, { rootMargin: '400px' });
          this.catalogObserver.observe(document.getElementById('catalog-sentinel'));
          window.addEventListener('pagehide', () => {
            clearTimeout(this.searchInputTimer);
            this.invalidateCatalog();
            this.catalogObserver.disconnect();
            this.clearTimestampUpdateTracker();
          });
          window.addEventListener('pageshow', event => {
            if (event.persisted) {
              this.catalogObserver.observe(document.getElementById('catalog-sentinel'));
              this.getVideos(this.CURRENT_SEARCH_TERM, this.CURRENT_SORT_TERM, this.CURRENT_TAG_TERM);
            }
          });
        }

        invalidateCatalog() {
          clearTimeout(this.catalogRetryTimer);
          this.catalogRetryTimer = null;
          this.catalogRetryCount = 0;
          this.catalogGeneration++;
          const request = this.catalogRequest;
          this.catalogRequest = null;
          this.catalogLoading = false;
          this.catalogHasMore = false;
          this.catalogError = false;
          if (request) request.abort();
        }

        getVideos(searchTerm, sortTerm, tagTerm) {
          clearTimeout(this.searchInputTimer);
          this.invalidateCatalog();
          this.CURRENT_SEARCH_TERM = searchTerm;
          this.CURRENT_SORT_TERM = sortTerm;
          this.CURRENT_TAG_TERM = tagTerm;
          this.catalogNextOffset = 0;
          this.catalogHasMore = true;
          this.catalogGroups.clear();
          this.clearTimestampUpdateTracker();
          document.getElementById('videos-container').replaceChildren();
          this.loadMoreVideos();
        }

        loadMoreVideos() {
          if (this.catalogLoading || !this.catalogHasMore || this.catalogRetryTimer !== null) return;
          const generation = this.catalogGeneration;
          this.catalogLoading = true;
          this.catalogError = false;
          this.updateCatalogStatus();
          const data = {
            sortTerm: this.CURRENT_SORT_TERM,
            offset: this.catalogNextOffset,
          };
          if (this.CURRENT_SEARCH_TERM) data.searchTerm = this.CURRENT_SEARCH_TERM;
          if (this.CURRENT_TAG_TERM) data.tagTerm = this.CURRENT_TAG_TERM;
          this.catalogRequest = $.ajax({ type: 'GET', url: '/node/search', data })
            .done(response => {
              if (generation !== this.catalogGeneration) return;
              if (response.isError) this.catalogError = true;
              else {
                this.catalogRetryCount = 0;
                this.acceptCatalogPage(response);
              }
            })
            .fail((xhr, status) => {
              if (generation === this.catalogGeneration && status !== 'abort') this.catalogError = true;
            })
            .always(() => {
              if (generation !== this.catalogGeneration) return;
              this.catalogRequest = null;
              this.catalogLoading = false;
              if (this.catalogError) {
                const delay = Math.min(1000 * 2 ** this.catalogRetryCount, 10000);
                this.catalogRetryCount = Math.min(this.catalogRetryCount + 1, 4);
                this.catalogRetryTimer = setTimeout(() => {
                  this.catalogRetryTimer = null;
                  if (generation === this.catalogGeneration) this.loadMoreVideos();
                }, delay);
              } else this.checkCatalogViewport();
              this.updateCatalogStatus();
            });
        }

        acceptCatalogPage(data) {
          this.catalogHasMore = data.hasMore;
          this.catalogNextOffset = data.nextOffset;
          if (this.CURRENT_TAG_TERM) this.loadVideos(data.searchResults, this.CURRENT_TAG_TERM);
          else for (const group of data.tagGroups) this.loadVideos(group.videos, group.tag);
          this.updateCatalogStatus();
          this.checkCatalogViewport();
        }

        checkCatalogViewport() {
          const generation = this.catalogGeneration;
          requestAnimationFrame(() => {
            if (generation !== this.catalogGeneration) return;
            const bounds = document.getElementById('catalog-sentinel').getBoundingClientRect();
            if (bounds.top <= window.innerHeight + 400 && bounds.bottom >= -400) this.loadMoreVideos();
          });
        }

        updateCatalogStatus(searching = false) {
          const loading = searching || this.catalogLoading || this.catalogError;
          document.getElementById('videos-container').setAttribute('aria-busy', String(loading));
          document.getElementById('videos-scroller-loading-spinner').hidden = !loading;
          document.getElementById('catalog-status').className = loading ? 'visually-hidden' : '';
          document.getElementById('catalog-status').textContent = loading
            ? 'Loading...'
            : !this.catalogGroups.size ? 'No videos found.' : '';
        }

        loadVideos(videos, tag) {
          if (!videos.length) return;
          let group = this.catalogGroups.get(tag);
          if (!group) {
            const outer = document.createElement('div');
            outer.className = 'container videos-container-outer p-0 pb-1 mt-2';
            const heading = document.createElement('div');
            heading.className = 'videos-container-inner-tag-title row justify-content-end pe-1';
            heading.style.cssText = 'background-color: #cb0c9f08; border: 1px solid #cb0c9f40; border-radius: 5px 5px 0 0; color: #cb0c9f; font-size: 13px;';
            const label = document.createElement('span');
            label.className = 'text-end p-0';
            const link = document.createElement('a');
            const params = new URLSearchParams({ sortTerm: this.CURRENT_SORT_TERM, tagTerm: tag });
            if (this.CURRENT_SEARCH_TERM) params.set('searchTerm', this.CURRENT_SEARCH_TERM);
            link.href = '?' + params.toString();
            link.textContent = tag + (this.CURRENT_TAG_TERM ? '' : ' >');
            label.append(link);
            heading.append(label);
            const inner = document.createElement('div');
            inner.className = 'videos-container-inner row row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4';
            outer.append(heading, inner);
            document.getElementById('videos-container').append(outer);
            group = { inner, ids: new Set() };
            this.catalogGroups.set(tag, group);
          }
          for (const row of videos) {
            if (group.ids.has(row.video_id)) continue;
            group.ids.add(row.video_id);
            const element = document.createElement('div');
            element.className = 'pt-1 pb-1 ps-1 pe-1';
            element.innerHTML = '<a class="text-decoration-none"><div class="card"><div class="position-relative ratio-16x9"><img class="card-img-top" loading="lazy" alt=""><i style="position:absolute;right:5px;bottom:5px;background:rgba(0,0,0,.8);color:white;border-radius:4px;padding:3px;font-size:11px"><span class="video-streaming-timestamp"></span></i></div><div class="card-body"><h6 class="card-title text-break row"></h6><small class="card-text text-break"><span class="video-views"></span> views &#x2022; <span class="video-info-timestamp"></span></small></div></div></a>';
            element.querySelector('a').href = '/watch?v=' + encodeURIComponent(row.video_id);
            element.querySelector('img').src = this.EXTERNAL_VIDEOS_BASE_URL + '/external/videos/' + encodeURIComponent(row.video_id) + '/images/preview.jpg';
            element.querySelector('.card-title').textContent = row.title;
            element.querySelector('.video-views').textContent = row.views;
            element.querySelector('.video-streaming-timestamp').textContent = this.convertSecondsToDurationFormatted(row.length_seconds);
            if (row.is_live) {
              const indicator = document.createElement('i');
              indicator.style.cssText = 'position:absolute;left:5px;bottom:5px;background:#cb0c9f;color:white;border-radius:4px;padding:3px;font-size:10px';
              indicator.textContent = row.is_streaming ? 'LIVE' : 'STREAMED';
              element.querySelector('.position-relative').append(indicator);
            }
            group.inner.append(element);
            this.applyTimestampUpdateTrackerToVideo(element, row.creation_timestamp, row.is_streaming);
          }
        }

      	applyTimestampUpdateTrackerToVideo(element, creationTimestamp, isStreaming) {
      		const updateCreationTimestamp = () => {
      			const creationTimestampFormatted = this.getCreationTimestampFormatted(creationTimestamp);

      			$(element).find('.video-info-timestamp').text(creationTimestampFormatted);

      			if (isStreaming) {
      				const lengthSeconds = Math.floor((Date.now() - creationTimestamp) / 1000);
      				const durationFormatted = this.convertSecondsToDurationFormatted(lengthSeconds);

      				$(element).find('.video-streaming-timestamp').text(durationFormatted);
      			}
      		};

      		updateCreationTimestamp();

      		const interval = setInterval(updateCreationTimestamp, 1000);

      		this.TIMESTAMP_UPDATE_TRACKER.push(interval);
      	}

      	clearTimestampUpdateTracker() {
      		this.TIMESTAMP_UPDATE_TRACKER.forEach((interval) => {
      			clearInterval(interval);
      		});

      		this.TIMESTAMP_UPDATE_TRACKER = [];
      	}

      	sortButtonClicked(sortButton) {
      		$('.sort-button').removeClass('content-button-selected');
      		$(sortButton).addClass('content-button-selected');

      		const sortTerm = $(sortButton).data('sortterm');

      		this.CURRENT_SORT_TERM = sortTerm;

      		this.updateAddressBar();

      		this.getVideos(this.CURRENT_SEARCH_TERM, this.CURRENT_SORT_TERM, this.CURRENT_TAG_TERM);
      	}

      	tagButtonSelected(tagButton) {
      		$('.tag-button').removeClass('content-button-selected');
      		$(tagButton).addClass('content-button-selected');

      		const tagTerm = $(tagButton).data('tagterm');

      		this.CURRENT_TAG_TERM = tagTerm.toString();

      		this.updateAddressBar();

      		this.getVideos(this.CURRENT_SEARCH_TERM, this.CURRENT_SORT_TERM, this.CURRENT_TAG_TERM);
      	}

      	searchInputEntered(input) {
      		const value = input.value;

      		this.CURRENT_SEARCH_TERM = value;
          this.invalidateCatalog();
          this.updateCatalogStatus(true);
          document.getElementById('catalog-status').textContent = 'Searching...';

      		clearTimeout(this.searchInputTimer);

      		this.searchInputTimer = setTimeout(() => {
      			this.updateAddressBar();

      			this.getVideos(this.CURRENT_SEARCH_TERM, this.CURRENT_SORT_TERM, this.CURRENT_TAG_TERM);
      		}, 500);
      	}






      	donateVideo() {
      		if (window.ethereum) {
      			let selectedCryptoWalletAddress;
      			let selectedChainId;

      			let optionsHtml = '<option selected disabled>Donate to crypto address...</option>';

      			this.CRYPTO_WALLET_ADDRESSES.forEach((cryptoWalletAddress) => {
      				const walletAddressId = cryptoWalletAddress.wallet_address_id;
      				const walletAddress = cryptoWalletAddress.wallet_address;
      				const chain = cryptoWalletAddress.chain;

      				optionsHtml += '<option value="' + walletAddressId + '">' + walletAddress + ' (' + chain + ')</option>';
      			});

      			const html = $('\
      					<div id="donate-modal" class="multisteps-form__content">\
      						<div class="text-center">\
      							<image class="img-fluid" src="' + this.EXTERNAL_RESOURCES_BASE_URL + '/external/resources/images/donate.jpg" style="max-width: 500px;"/>\
      						</div>\
      						<div class="row mt-3">\
      							<div class="col-12">\
      								<select id="wallet-address-select" class="multisteps-form__select form-control">' + optionsHtml + '</select>\
      							</div>\
      						</div>\
      						<div class="mt-3">\
      							<input id="donation-amount-input" class="multisteps-form__input form-control text-center" type="number" placeholder="donation amount" disabled>\
      						</div>\
      					</div>\
      				');

      			Swal.fire({
      				title: 'Donate to Creator',
      				html: html,
      				width: 'auto',
      				showConfirmButton: true,
      				confirmButtonText: 'Continue',
      				showCloseButton: true,
      				showCancelButton: true,
      				willOpen: () => {
      					$(swal.getConfirmButton()).prop('disabled', true)
      				},
      				didOpen: () => {
      					$('#wallet-address-select').on('change', function () {
      						const walletAddressId = Number(this.value);

      						for (const cryptoWalletAddress of this.CRYPTO_WALLET_ADDRESSES) {
      							if (cryptoWalletAddress.wallet_address_id === walletAddressId) {
      								selectedCryptoWalletAddress = cryptoWalletAddress;

      								$('#donation-amount-input').attr('placeholder', 'donation amount (' + cryptoWalletAddress.currency + ')');
      								$('#donation-amount-input').removeAttr('disabled');

      								break;
      							}
      						}
      					}.bind(this));

      					$('#donation-amount-input').on('input', function () {
      						const donationAmount = this.value;

      						if (donationAmount.length === 0) {
      							$(swal.getConfirmButton()).prop('disabled', true)
      						}
      						else {
      							$(swal.getConfirmButton()).prop('disabled', false)
      						}
      					});
      				}
      			})
      				.then((result) => {
      					if (result.isConfirmed) {
      						const walletAddress = selectedCryptoWalletAddress.wallet_address;
      						const chain = selectedCryptoWalletAddress.chain;
      						const chainId = selectedCryptoWalletAddress.chain_id;
      						const donationAmount = $('#donation-amount-input').val();

      						this.openCryptoClient(walletAddress, chain, chainId, donationAmount);
      					}
      				});
      		}
      		else {
      			Swal.fire({
      				title: 'Missing Crypto Wallet',
      				html: 'Your browser doesn\'t have a supported crypto wallet installed.<br>MoarTube supports crypto wallets that conform to the EIP-1193 standard.<br>Would you like to be directed to a supported crypto wallet? ',
      				width: 'auto',
      				icon: "info",
      				showConfirmButton: true,
      				confirmButtonText: '<a href="https://metamask.io/download" target="_blank" style="text-decoration: none; color: white;">Continue</a>',
      				cancelButtonText: 'Cancel',
      				showCloseButton: true,
      				showCancelButton: true
      			});
      		}
      	}

      	async openCryptoClient(walletAddress, chain, chainId, donationAmount) {
      		if (window.ethereum) {
      			try {
      				await ethereum.request({
      					method: 'wallet_switchEthereumChain',
      					params: [{ chainId: chainId }]
      				});

      				console.log('Crypto wallet changed to Mainnet ' + chain);

      				const accounts = await ethereum.request({ method: 'eth_requestAccounts' });

      				if (accounts) {
      					const web3 = new Web3(ethereum);

      					const weiAmount = web3.utils.toWei(donationAmount, 'ether');
      					const weiAmountHex = web3.utils.toHex(BigInt(weiAmount));

      					const transactionParams = {
      						to: walletAddress,
      						from: accounts[0],
      						value: weiAmountHex
      					};

      					await ethereum.request({
      						method: 'eth_sendTransaction',
      						params: [transactionParams]
      					});

      					console.log('Crypto wallet transaction initiated');
      				}
      			}
      			catch (error) {
      				console.error(error);
      			}
      		}
      	}

      	showSettings() {
      		if (typeof (Storage) != null) {
      			let value = localStorage.getItem('dark-mode-enabled') === 'true';

      			if (value) {
      				$('#darkModeSwitch').prop('checked', true);
      			}
      			else {
      				$('#darkModeSwitch').prop('checked', false);
      			}

      			$('#darkModeSwitch').off('change');
      			$('#darkModeSwitch').change(async function () {
      				this.IS_DARK_MODE_ENABLED = $('#darkModeSwitch').prop('checked');

      				if (this.IS_DARK_MODE_ENABLED) {
      					$('#dark-mode-style').prop('disabled', false);
      				}
      				else {
      					$('#dark-mode-style').prop('disabled', true);
      				}

      				if (typeof (Storage) != null) {
      					localStorage.setItem('dark-mode-enabled', this.IS_DARK_MODE_ENABLED);
      				}
      				else {
      					console.log('localStorage is not supported in this browser.');
      				}
      			}.bind(this));
      		}
      		else {
      			console.log('localStorage is not supported in this browser.');
      		}
      	}

      	updateAddressBar() {
      		const params = [];

      		if (this.CURRENT_SEARCH_TERM && this.CURRENT_SEARCH_TERM.trim() !== '') {
      			params.push('searchTerm=' + encodeURIComponent(this.CURRENT_SEARCH_TERM));
      		}

      		if (this.CURRENT_SORT_TERM && this.CURRENT_SORT_TERM.trim() !== '') {
      			params.push('sortTerm=' + encodeURIComponent(this.CURRENT_SORT_TERM));
      		}

      		if (this.CURRENT_TAG_TERM && this.CURRENT_TAG_TERM.trim() !== '') {
      			params.push('tagTerm=' + encodeURIComponent(this.CURRENT_TAG_TERM));
      		}

      		const stateString = params.length > 0 ? '?' + params.join('&') : '';

      		window.history.replaceState({}, '', stateString);
      	}

      	getCreationTimestampFormatted(creationTimestamp) {
      		let timeElapsed = '';

      		const timeDifference = Date.now() - creationTimestamp;

      		if (timeDifference < 60000) {
      			timeElapsed = "just now"
      		} else if (timeDifference < 3600000) {
      			const minutes = Math.floor(timeDifference / 60000);
      			if (minutes === 1) {
      				timeElapsed = "1 minute ago"
      			} else if (minutes === 0 || minutes > 1) {
      				timeElapsed = minutes + " minutes ago"
      			}
      		} else if (timeDifference < 86400000) {
      			const hours = Math.floor(timeDifference / 3600000);
      			if (hours === 1) {
      				timeElapsed = "1 hour ago"
      			} else if (hours === 0 || hours > 1) {
      				timeElapsed = hours + " hours ago"
      			}
      		} else if (timeDifference < 2592000000) {
      			const days = Math.floor(timeDifference / 86400000);
      			if (days === 1) {
      				timeElapsed = "1 day ago"
      			} else if (days === 0 || days > 1) {
      				timeElapsed = days + " days ago"
      			}
      		} else if (timeDifference < 31536000000) {
      			const months = Math.floor(timeDifference / 2592000000);
      			if (months === 1) {
      				timeElapsed = "1 month ago"
      			} else if (months === 0 || months > 1) {
      				timeElapsed = months + " months ago"
      			}
      		} else {
      			const years = Math.floor(timeDifference / 31536000000);
      			if (years === 1) {
      				timeElapsed = "1 year ago"
      			} else if (years === 0 || years > 1) {
      				timeElapsed = years + " years ago"
      			}
      		}

      		return timeElapsed;
      	}

      	convertSecondsToDurationFormatted(seconds) {
      		seconds = Math.floor(seconds);

      		const years = Math.floor(seconds / (3600 * 24 * 365));

      		seconds -= years * (3600 * 24 * 365);

      		const days = Math.floor(seconds / (3600 * 24));

      		seconds -= days * (3600 * 24);

      		const hours = Math.floor(seconds / 3600);

      		seconds -= hours * 3600;

      		const minutes = Math.floor(seconds / 60);

      		seconds -= minutes * 60;

      		let durationFormatted = '';

      		if (years > 0) {
      			durationFormatted += years + ' years, ';
      		}

      		if (days > 0) {
      			durationFormatted += days + ' days, ';
      		}

      		if (hours > 0 || years > 0 || days > 0) {
      			durationFormatted += hours + ':';
      		}

      		if (minutes < 10 && (hours > 0 || years > 0 || days > 0)) {
      			durationFormatted += '0';
      		}

      		durationFormatted += minutes + ':';

      		if (seconds < 10) {
      			durationFormatted += '0';
      		}

      		durationFormatted += seconds;

      		return durationFormatted;
      	}
      }

      if (window.ethereum != null) {
      	console.log('EIP-1193 compatible crypto wallet detected.');
      } else {
      	console.log('EIP-1193 compatible crypto wallet not detected!');
      }

      const moarTubeNode = new MoarTubeNode();

      $(document).ready(function () {
      	moarTubeNode.init();
      });
    </script>
  </body>
