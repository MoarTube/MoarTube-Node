  <div class="container-fluid home-page">

    <header class="home-header">
      <a class="brand" href="/" aria-label="<%= model.settings.nodeName %> home"><img class="node-banner" src="/external/resources/images/banner.png" alt="<%= model.settings.nodeName %> banner"></a>
      <nav class="mobile-tabs" role="tablist" aria-label="Node sections">
        <% for (const view of ['videos','about','community']) { %><button id="tab-<%= view %>" type="button" role="tab" aria-controls="<%= view === 'community' ? 'community-panel' : view + '-panel' %>" aria-selected="<%= model.query.view === view %>" data-view="<%= view %>"><%= view[0].toUpperCase()+view.slice(1) %></button><% } %>
      </nav>
    </header>
    <main class="home-layout">
      <section id="videos-panel" class="videos-panel" aria-label="Videos">
        <div class="video-toolbar">
          <nav class="sort-tabs" aria-label="Sort videos"><% for (const [value,label] of [['hot','Hot'],['new','New'],['recently-discussed','Recently discussed'],['discussed','Most discussed'],['viewed','Most viewed']]) { %><button type="button" data-sort="<%= value %>" aria-pressed="<%= model.query.sortTerm === value %>"><%= label %></button><% } %></nav>
          <label class="mobile-sort"><span class="visually-hidden">Sort videos</span><select id="sort-select" class="form-select"><option value="hot">Hot</option><option value="new">New</option><option value="recently-discussed">Recently discussed</option><option value="discussed">Most discussed</option><option value="viewed">Views</option></select></label>
          <details id="tag-picker" class="tag-picker"><summary><span id="selected-tag">All tags</span><span aria-hidden="true">&#8964;</span></summary><div class="tag-menu"><label for="tag-search" class="visually-hidden">Search tags</label><input id="tag-search" class="form-control" type="search" maxlength="500" placeholder="Search tags&#8230;" value="<%= model.query.tagSearch %>"><div id="tag-options" class="tag-options" aria-label="Choose a tag"></div><button id="mobile-more-tags" type="button" class="btn btn-sm" hidden>More tags</button></div></details>
          <button id="search-toggle" class="search-toggle" type="button" aria-label="Search videos" aria-controls="video-search" aria-expanded="false"><svg class="icon" aria-hidden="true"><use href="#icon-search"/></svg></button>
          <form id="video-search" class="video-search" role="search">
            <label class="search-box"><svg class="icon" aria-hidden="true"><use href="#icon-search"/></svg><input id="search-input" name="searchTerm" type="search" maxlength="500" placeholder="Search videos and tags…" aria-label="Search videos" value="<%= model.query.searchTerm %>"></label>
          </form>
        </div>
        <div class="tag-bar"><nav id="tag-rail" class="tag-rail" aria-label="Video tags"></nav><button id="more-tags" type="button" class="btn btn-sm" hidden>More tags</button></div>
        <div id="tag-status" role="status"></div>
        <div id="video-grid" class="video-grid"></div>
        <div id="video-status" class="feed-status" role="status"></div>
        <div id="video-sentinel" class="feed-sentinel" aria-hidden="true"></div>
      </section>
      <aside class="home-sidebar">
        <div class="sidebar-introduction"><div class="network-identity"><strong data-setting="nodeName"><%= model.settings.nodeName %></strong></div>
          <img class="node-avatar" src="/external/resources/images/avatar.png" width="96" height="96" alt="">
          <section class="desktop-intro node-intro" aria-label="About this node"><h1 data-setting="nodeHeadline"><%= model.settings.nodeHeadline %></h1><p data-setting="nodeAbout"><%= model.settings.nodeAbout %></p></section>
        </div>
        <div id="about-panel" class="about-panel">
          <section class="mobile-intro node-intro" aria-label="About this node"><h1 data-setting="nodeName"><%= model.settings.nodeName %></h1><img class="node-avatar" src="/external/resources/images/avatar.png" width="96" height="96" alt=""><h3 data-setting="nodeHeadline"><%= model.settings.nodeHeadline %></h3><p data-setting="nodeAbout"><%= model.settings.nodeAbout %></p></section>
          <section class="panel bulletin-panel" aria-labelledby="bulletin-heading"><h2 id="bulletin-heading">Bulletin</h2><ul id="bulletin"><% for (const item of model.settings.nodeBulletin) { %><li><%= item %></li><% } %></ul><p id="bulletin-empty" class="empty-settings" <%= model.settings.nodeBulletin.length ? 'hidden' : '' %>>No bulletin items yet.</p></section>
        </div>
        <section id="community-panel" class="comments-panel panel" aria-labelledby="comments-heading">
          <div class="comments-header"><h2 id="comments-heading">Community</h2><button id="comments-search-toggle" type="button" class="comments-search-toggle" aria-label="Search comments" aria-controls="comment-search" aria-expanded="false"><svg class="icon" aria-hidden="true"><use href="#icon-search"/></svg></button></div>
          <form id="comment-search" class="comment-search" role="search" aria-label="Comment search" hidden><label class="search-box"><svg class="icon" aria-hidden="true"><use href="#icon-search"/></svg><input id="comment-search-input" name="commentSearch" type="search" maxlength="500" placeholder="Search comments&#8230;" aria-label="Search comment text" value="<%= model.query.commentSearch || '' %>"></label></form>
          <div id="comment-list"></div><div id="comment-status" class="feed-status" role="status"></div>
          <nav hidden class="comment-pagination" aria-label="Latest comments pages"><button id="comments-prev" type="button" class="btn" disabled>← Previous</button><span id="comment-page">Page 1</span><button id="comments-next" type="button" class="btn" disabled>Next →</button></nav>
          <div id="comment-sentinel" class="feed-sentinel" aria-hidden="true"></div>
        </section>
        <section class="panel links-panel about-panel" aria-labelledby="links-heading"><h2 id="links-heading">Links</h2><div id="links"><% for (const link of model.settings.nodeLinks) { %><div class="node-link"><a href="<%= link.url %>" rel="noopener noreferrer"><%= new URL(link.url).hostname %></a><span><%= link.description %></span></div><% } %></div><p id="links-empty" class="empty-settings" <%= model.settings.nodeLinks.length ? 'hidden' : '' %>>No links yet.</p></section>
      </aside>
    </main>
    <div id="settings-dialog" class="modal fade" tabindex="-1" aria-labelledby="settings-title" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 id="settings-title" class="modal-title">Settings</h5>
            <button type="button" class="btn-close dialog-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="form-check form-switch">
              <input id="darkModeSwitch" class="form-check-input" type="checkbox" role="switch">
              <label class="form-check-label" for="darkModeSwitch">dark mode</label>
            </div>
          </div>
        </div>
      </div>
    </div>
    <template id="donate-content">
      <div id="donate-modal" class="multisteps-form__content">
        <div class="text-center"><img class="img-fluid" src="/external/resources/images/donate.jpg" style="max-width: 500px; width: 100%;" alt="Support the creator"></div>
        <p id="donate-status" role="status"></p>
        <form id="donate-form" hidden>
          <div class="row mt-3"><div class="col-12">
            <select id="wallet-address-select" class="multisteps-form__select form-control" aria-label="Donate to crypto address" required><option value="" selected disabled>Donate to crypto address...</option></select>
          </div></div>
          <div class="mt-3"><input id="donation-amount-input" class="multisteps-form__input form-control text-center" type="text" inputmode="decimal" aria-label="Donation amount" placeholder="donation amount" required autocomplete="off" disabled></div>
        </form>
      </div>
    </template>
    <noscript><p class="alert alert-light">Enable JavaScript to search and browse videos and comments.</p></noscript>
  </div>
</body>
</html>
