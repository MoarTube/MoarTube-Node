    <script src="<%=model.externalResourcesBaseUrl%>/external/resources/javascript/videojs-8.6.1.js"></script>
    <script src="<%=model.externalResourcesBaseUrl%>/external/resources/javascript/videojs-landscape-fullscreen.min.js"></script>
    <script src="<%=model.externalResourcesBaseUrl%>/external/resources/javascript/sweetalert-11.0.11.min.js"></script>
    <script src="<%=model.externalResourcesBaseUrl%>/external/resources/javascript/keen-slider-6.8.5.min.js"></script>

    <script>
      const INCOMING_PARAMETERS = <%- JSON.stringify(model) %>;

      class MoarTubeWatch {
        constructor() {
          this.INCOMING_PARAMETERS = INCOMING_PARAMETERS;
          this.VIDEO_ID = null;
          this.VIEW_COUNT = null;
          this.TIME_PARAMETER = null;
          this.HASH_VALUE = '';
          this.NODE_NAME = null;
          this.NODE_PROTOCOL = null;
          this.NODE_ADDRESS = null;
          this.NODE_PORT = null;
          this.NODE_BASE_URL = null;
          this.CLOUDFLARE_TURNSTILE_SITE_KEY = null;
          this.COMMENT_ELEMENT_CACHE = {};
          this.RECOMMENDED_VIDEOS_TAGS_CACHE = { '': [] };
          this.DOWNLOADABLE_SOURCES = [];
          this.MOST_RECENT_VISIBLE_COMMENT_TIMESTAMP = 0;
          this.CURRENT_VIDEO_RESOLUTION = null;
          this.CURRENT_VIDEO_FORMAT = null;
          this.TIMESTAMP_UPDATE_TRACKER = [];
          this.CRYPTO_WALLET_ADDRESSES = [];
          this.EXTERNAL_VIDEOS_BASE_URL = null;
          this.EXTERNAL_RESOURCES_BASE_URL = null;
          this.THEATER_MODE_BUTTON = null;
          this.IS_DARK_MODE_ENABLED = false;
          this.IS_STREAMING = false;
          this.COMMENT_INPUT_FORM_DYNAMIC = $('\
            <form id="comment-input-form-dynamic" class="comment-input-form" role="form" method="POST" data-commentformtype="dynamic" style="background: #cb0c9f12;padding: 5px 5px 5px 5px;">\
              <textarea class="w-100 border-top-0 border-end-0 border-start-0 comment-input-text-area" rows="1" placeholder="Add a comment..." maxlength="500" name="commentPlainText"></textarea>\
              <div class="text-end mt-1">\
                <div id="comment-input-form-dynamic-submit-container">\
                  <button id="comment-input-form-dynamic-cancel-button-inner" class="btn btn-outline-primary" type="button" data-commentformtype="dynamic">cancel</button>\
                  <button class="btn btn-outline-primary" type="submit">submit</button>\
                  <div id="comment-input-form-dynamic-error-message"></div>\
                </div>\
              </div>\
            </form>');
        }

        init() {
          const params = new URL(window.location.href).searchParams;
          this.VIDEO_ID = params.get('v');
          if (this.VIDEO_ID != null) {
            this.HASH_VALUE = window.location.hash;
            this.TIME_PARAMETER = params.get('t');
            if (this.TIME_PARAMETER != null) {
              this.TIME_PARAMETER = Number(this.TIME_PARAMETER);
              if (Number.isNaN(this.TIME_PARAMETER)) {
                this.TIME_PARAMETER = null;
              }
            }
            this.EXTERNAL_VIDEOS_BASE_URL = this.INCOMING_PARAMETERS.externalVideosBaseUrl;
            this.EXTERNAL_RESOURCES_BASE_URL = this.INCOMING_PARAMETERS.externalResourcesBaseUrl;
            this.loadInformation(this.INCOMING_PARAMETERS.informationData.information);
            this.loadLinks(this.INCOMING_PARAMETERS.linksData.links);
            this.loadCryptoWalletAddresses(this.INCOMING_PARAMETERS.cryptoWalletAddressesData.cryptoWalletAddresses);
            this.loadVideo(this.INCOMING_PARAMETERS.videoData.video);
            this.loadTags(this.INCOMING_PARAMETERS.recommendedVideosData.recommendedVideos);
            this.loadRecommendedVideos(this.INCOMING_PARAMETERS.recommendedVideosData.recommendedVideos, true);
            this.loadComments(this.INCOMING_PARAMETERS.commentsData.comments, false);
            $('#video-poster').attr('src', this.EXTERNAL_VIDEOS_BASE_URL + '/external/videos/' + this.VIDEO_ID + '/images/poster.jpg');
            if (this.HASH_VALUE !== '') {
              if ($(this.HASH_VALUE + ' .postNum a:first-child').length) {
                $(this.HASH_VALUE + ' .postNum a:first-child')[0].click();
              }
            }
            this.refreshTextAreas();
          }
          if (window.ethereum != null) {
            console.log('EIP-1193 compatible crypto wallet detected.');
          } else {
            console.log('EIP-1193 compatible crypto wallet not detected!');
          }

          // Set up event listeners for UI interactions
          this.setupEventListeners();
        }

        setupEventListeners() {
          // Navbar buttons
          $('#navbar-donate-button').off('click').on('click', () => this.donateVideo());
          $('#navbar-settings-button').off('click').on('click', () => this.showSettings());

          // Video action buttons
          $('#video-like-button').off('click').on('click', () => this.likeVideo());
          $('#video-dislike-button').off('click').on('click', () => this.dislikeVideo());
          $('#video-share-button').off('click').on('click', () => this.shareVideo());
          $('#video-donate-button').off('click').on('click', () => this.donateVideo());
          $('#video-download-button').off('click').on('click', () => this.downloadVideo());
          $('#video-report-button').off('click').on('click', () => this.showVideoReportModal());

          // Comment section
          $('#expand-comment-section').off('click').on('click', () => this.openCommentSection());
          $('#comment-section-back-button').off('click').on('click', () => this.closeCommentSection());
          $('#update-comments-button').off('click').on('click', () => this.updateComments());

          // Chat donate button
          $('#donate-button').off('click').on('click', () => this.donateVideo());

          // Dynamic comment elements (delegated events)
          $(document).off('click', '.comment-report-button').on('click', '.comment-report-button', (e) => {
            const commentId = $(e.target).data('comment-id');
            const timestamp = $(e.target).data('timestamp');
            this.showCommentReportModal(commentId, timestamp);
          });

          $(document).off('click', '.quotelink').on('click', '.quotelink', (e) => {
            e.preventDefault();
            const commentId = $(e.target).data('comment-id');
            this.quote(commentId);
          });

          // Comment form cancel button (complex jQuery inline handler)
          $(document).off('click', '#comment-input-form-dynamic-cancel-button-inner').on('click', '#comment-input-form-dynamic-cancel-button-inner', function() {
            $('#comment-input-form-dynamic').remove();
            $(this).parent().parent().parent().find('textarea').val('');
          });

          // Comment form submission
          $(document).off('submit', '.comment-input-form').on('submit', '.comment-input-form', (event) => {
            this.handleCommentSubmit(event, event.target);
          });
        }

        loadInformation(information) {
          this.NODE_NAME = information.nodeName;
          this.NODE_PROTOCOL = information.publicNodeProtocol;
          this.NODE_ADDRESS = information.publicNodeAddress;
          this.NODE_PORT = information.publicNodePort;
          let port;
          if (this.NODE_PROTOCOL === 'http') {
            port = this.NODE_PORT == 80 ? '' : ':' + this.NODE_PORT;
          } else if (this.NODE_PROTOCOL === 'https') {
            port = this.NODE_PORT == 443 ? '' : ':' + this.NODE_PORT;
          }
          this.NODE_BASE_URL = this.NODE_PROTOCOL + '://' + this.NODE_ADDRESS + port;
          this.CLOUDFLARE_TURNSTILE_SITE_KEY = information.cloudflareTurnstileSiteKey;
        }

        loadLinks(links) {
          for (let i = links.length - 1; i >= 0; i--) {
            const link = links[i];
            const url = link.url;
            const svgGraphic = link.svg_graphic;
            const $link = $('<a>')
              .attr('href', url)
              .attr('target', '_blank')
              .addClass('navbar-settings-button navbar-brand')
              .attr('role', 'button')
              .html(svgGraphic);
            $('#navbar-settings-buttons').prepend($link);
          }
        }

        loadCryptoWalletAddresses(cryptoWalletAddresses) {
          this.CRYPTO_WALLET_ADDRESSES = cryptoWalletAddresses;
        }

        loadTags(recommendedVideos) {
          const tags = [];
          recommendedVideos.forEach(recommendedVideo => {
            const tagsArray = recommendedVideo.tags.split(',');
            tagsArray.forEach(tag => {
              if (!tags.includes(tag)) {
                tags.push(tag);
              }
            });
          });
          tags.forEach(tag => {
            $('#recommended-videos-tag-slider').append('<div class="keen-slider__slide number-slide2"><button type="button" class="btn btn-outline-primary recommendation-category-button" data-tagterm="' + tag + '" style="white-space: nowrap;">' + tag + '</button></div>');
          });
          const recommendationsSlider = new KeenSlider("#recommended-videos-tag-slider", {
            loop: false,
            mode: "free",
            rtl: false,
            slides: { perView: "auto", spacing: 5 }
          });
          let recommendationCategoryButtonOffsetLeft;
          $(".recommendation-category-button").on("mouseup", function (e) {
            const movementDifference = Math.abs(recommendationCategoryButtonOffsetLeft - $(this).offset().left);
            if (movementDifference < 10) {
              $('.recommendation-category-button').removeClass('recommendation-category-button-selected');
              $(this).addClass('recommendation-category-button-selected');
            }
          });
          $(".recommendation-category-button").on("mousedown", function (e) {
            recommendationCategoryButtonOffsetLeft = $(this).offset().left;
          });
          $(".recommendation-category-button").on("click", (e) => {
            const tagTerm = $(e.target).data('tagterm').toString();
            $('#recommended-videos-list').empty();
            this.loadRecommendedVideos(this.RECOMMENDED_VIDEOS_TAGS_CACHE[tagTerm], false);
          });
        }

        loadRecommendedVideos(recommendedVideos, updateCache) {
          this.clearTimestampUpdateTracker();
          recommendedVideos.forEach(recommendedVideo => {
            if (updateCache) {
              const tagsArray = recommendedVideo.tags.split(',');
              tagsArray.forEach(tag => {
                if (!this.RECOMMENDED_VIDEOS_TAGS_CACHE.hasOwnProperty(tag)) {
                  this.RECOMMENDED_VIDEOS_TAGS_CACHE[tag] = [recommendedVideo];
                } else {
                  this.RECOMMENDED_VIDEOS_TAGS_CACHE[tag].push(recommendedVideo);
                }
                if (!this.RECOMMENDED_VIDEOS_TAGS_CACHE[''].includes(recommendedVideo)) {
                  this.RECOMMENDED_VIDEOS_TAGS_CACHE[''].push(recommendedVideo);
                }
              });
            }
            this.loadRecommendedVideo(recommendedVideo);
          });
        }

        loadRecommendedVideo(recommendedVideo) {
          const videoId = recommendedVideo.videoId;
          const title = recommendedVideo.title;
          const views = (videoId === this.VIDEO_ID ? this.VIEW_COUNT != null ? this.VIEW_COUNT : '...' : recommendedVideo.views);
          const isLive = recommendedVideo.isLive;
          const isStreaming = recommendedVideo.isStreaming;
          const lengthSeconds = recommendedVideo.lengthSeconds;
          const creationTimestamp = recommendedVideo.creationTimestamp;
          const durationFormatted = this.convertSecondsToDurationFormatted(lengthSeconds);
          const viewsFormatted = this.getViewsFormatted(views);
          let liveStreamIndicator = '';
          if (isLive) {
            if (isStreaming) {
              liveStreamIndicator = '<i style="position: absolute; left: 5px; bottom: 5px; background-color: #cb0c9f; color: white; border-radius: 4px; padding: 3px; font-size: 10px; font-weight: 500;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-broadcast" viewBox="0 0 16 16"><path d="M3.05 3.05a7 7 0 0 0 0 9.9.5.5 0 1 1-.707.707 8 8 0 0 1 0-11.314.5.5 0 0 1 .707.707zm2.122 2.122a4 4 0 0 0 0 5.656.5.5 0 1 1-.708.708 5 5 0 0 1 0-7.072.5.5 0 0 1 .708.708zm5.656-.708a.5.5 0 0 1 .708 0 5 5 0 0 1 0 7.072.5.5 0 1 1-.708-.708 4 4 0 0 0 0-5.656.5.5 0 0 1 0-.708zm2.122-2.12a.5.5 0 0 1 .707 0 8 8 0 0 1 0 11.313.5.5 0 0 1-.707-.707 7 7 0 0 0 0-9.9.5.5 0 0 1 0-.707zM10 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/></svg>&nbspLIVE</i>';
            } else {
              liveStreamIndicator = '<i style="position: absolute; left: 5px; bottom: 5px; background-color: #cb0c9f; color: white; border-radius: 4px; padding: 3px; font-size: 10px; font-weight: 500;">STREAMED</i>';
            }
          }
          const element = $(
            '<li class="list-group-item ps-0 pe-0 mt-2 video-recommendation-card border-0">\
              <a href="/watch?v=' + videoId + '" class="text-decoration-none">\
                <div class="card video-recommendation-card border-0">\
                  <div class="row g-0 position-relative">\
                    <div class="col-6 position-relative">\
                      <div class="position-relative">\
                        <img src="' + this.EXTERNAL_VIDEOS_BASE_URL + '/external/videos/' + videoId + '/images/preview.jpg" class="rounded ratio ratio-16x9" alt="..."/>\
                        <i class="video-streaming-timestamp">' + durationFormatted + '</i>\
                        ' + liveStreamIndicator + '\
                      </div>\
                    </div>\
                    <div class="col-6">\
                      <div class="h-100 ms-1">\
                        <span class="video-recommendation-card-text" style="overflow: hidden;text-overflow: ellipsis;white-space: normal;-webkit-line-clamp: 2;display: -webkit-box;-webkit-box-orient: vertical;font-weight: 500;font-family: &quot;Roboto&quot;,&quot;Arial&quot;,sans-serif;">' + title + '</span>\
                        <small class="video-recommendation-card-text"><span id="recommended-video-info-views-' + videoId + '">' + viewsFormatted + '</span> &#x2022 <span class="video-info-timestamp"></span></small>\
                      </div>\
                    </div>\
                  </div>\
                </div>\
              </a>\
            </li>');
          $('#recommended-videos-list').append(element);
          this.applyTimestampUpdateTrackerToVideo(element, creationTimestamp, isStreaming);
        }

        applyTimestampUpdateTrackerToVideo(element, creationTimestamp, isStreaming) {
          const updateCreationTimestamp = () => {
            const creationTimestampFormatted = this.getCreationTimestampFormatted(creationTimestamp);
            $(element).find('.video-info-timestamp').text(creationTimestampFormatted);
            if (isStreaming) {
              const lengthSeconds = Math.floor((Date.now() - creationTimestamp) / 1000);
              const durationFormatted = this.convertSecondsToDurationFormatted(lengthSeconds);
              $(element).find('.video-streaming-timestamp').text(durationFormatted);
            }
          };
          updateCreationTimestamp();
          const interval = setInterval(updateCreationTimestamp, 1000);
          this.TIMESTAMP_UPDATE_TRACKER.push(interval);
        }

        clearTimestampUpdateTracker() {
          this.TIMESTAMP_UPDATE_TRACKER.forEach(interval => clearInterval(interval));
          this.TIMESTAMP_UPDATE_TRACKER = [];
        }

        setClipboard(value) {
          try {
            navigator.clipboard.writeText(value).then(() => {}).catch(() => this.fallback(value));
          } catch (error) {
            this.fallback(value);
          }
        }

        fallback(value) {
          const tempInput = $('<input>');
          tempInput.css({ position: 'absolute', left: '-1000px', top: '-1000px' });
          tempInput.val(value);
          $('body').append(tempInput);
          tempInput.select();
          document.execCommand("copy");
          tempInput.remove();
        }

        refreshClickTooltips() {
          $('.click-tooltip[data-bs-toggle="tooltip"]').tooltip({ trigger: 'click', container: '.swal2-html-container' });
          $('.click-tooltip[data-bs-toggle="tooltip"]').on('click', function () {
            setTimeout(() => $(this).tooltip('hide'), 500);
          });
        }

        refreshTextAreas() {
          $("textarea").each(function () {
            if (this.scrollHeight > 0) {
              this.setAttribute("style", "height:" + (this.scrollHeight) + "px;overflow-y:hidden;resize:none;");
            } else {
              this.setAttribute("style", "height:30px;overflow-y:hidden;resize:none;");
            }
          }).on("input", function () {
            this.style.height = 0;
            this.style.height = (this.scrollHeight) + "px";
          });
        }

        loadVideo(video) {
          const title = video.title;
          const description = video.description;
          const likes = video.likes;
          const dislikes = video.dislikes;
          const comments = video.comments;
          const isPublished = video.isPublished;
          const isPublishing = video.isPublishing;
          const isLive = video.isLive;
          const isStreaming = video.isStreaming;
          const isStreamed = video.isStreamed;
          const creationTimestamp = video.creationTimestamp;
          const adaptiveSources = video.adaptiveSources;
          const progressiveSources = video.progressiveSources;
          const sourcesFormatsAndResolutions = video.sourcesFormatsAndResolutions;
          this.DOWNLOADABLE_SOURCES = progressiveSources;
          this.IS_STREAMING = isStreaming;
          if (isStreaming) {
            this.connectWebsocket();
          }
          document.title = title + ' - MoarTube';
          $('#node-name').text(this.NODE_NAME);
          $('#video-like-count').text(likes);
          $('#video-dislike-count').text(dislikes);
          $('#video-title').text(title);
          (async () => {
            try {
              const views = await this.incrementViews();
              this.VIEW_COUNT = views;
              const viewsFormatted = this.getViewsFormatted(views);
              if (!isStreaming) {
                $('#video-information-views').text(viewsFormatted);
              }
              $('#recommended-video-info-views-' + this.VIDEO_ID).text(viewsFormatted);
            } catch (error) {
              console.error(error.message);
            }
          })();
          (() => {
            const updateCreationTimestamp = () => {
              const creationTimestampFormatted = this.getCreationTimestampFormatted(creationTimestamp);
              if (isLive) {
                if (isStreaming) {
                  $('#video-information-date').text('Started streaming ' + creationTimestampFormatted);
                } else {
                  $('#video-information-date').text('Streamed live ' + creationTimestampFormatted);
                }
              } else {
                $('#video-information-date').text(creationTimestampFormatted);
              }
              setTimeout(updateCreationTimestamp, 1000);
            };
            updateCreationTimestamp();
          })();
          $('#video-information-description').text(description);
          let message = '';
          if (adaptiveSources.length > 0 || progressiveSources.length > 0) {
            if (isPublished || isStreaming) {
              this.initializeVideoJsPlayer(adaptiveSources, progressiveSources, sourcesFormatsAndResolutions, isStreaming);
            } else if (isStreamed) {
              message = 'this live stream has ended and has not been published';
            } else {
              message = 'this video is unavailable';
            }
          } else {
            if (isPublishing) {
              message = 'this video is currently publishing, please check back later';
            } else if (isStreaming) {
              message = 'this live stream has not started yet';
            } else if (isStreamed) {
              message = 'this live stream has ended and has not been published';
            } else {
              message = 'this video is unavailable';
            }
          }
          if (message != '') {
            $('#mtp-video-overlay').remove();
            $('#video-player-container').append('<div class="d-flex align-items-center justify-content-center">' + message + '</div>');
          }
        }

        async incrementViews() {
          try {
            const data = await $.ajax({ type: 'GET', url: '/videos/' + this.VIDEO_ID + '/views/increment' });
            if (data.isError) throw new Error(data.message);
            return data.views;
          } catch (error) {
            throw new Error('unable to communicate with node');
          }
        }

        initializeVideoJsPlayer(adaptiveSources, progressiveSources, sourcesFormatsAndResolutions, isStreaming) {
          window.videojs.log.level("off");
          $("#video-player").attr("controls", true);
          const sources = adaptiveSources.concat(progressiveSources);
          let player = videojs('video-player', {
            sources: sources,
            html5: { vhs: { overrideNative: !videojs.browser.IS_SAFARI, llhls: true }, nativeAudioTracks: false, nativeVideoTracks: false },
            liveui: true,
            errorDisplay: false,
            liveTracker: { trackingThreshold: 0 },
            preload: "auto",
            disablePictureInPicture: true,
            controlBar: { pictureInPictureToggle: false }
          });
          player.landscapeFullscreen();
          this.configurePlayerButtons(player, adaptiveSources, progressiveSources, sourcesFormatsAndResolutions, isStreaming);
          this.configurePlayerEvents(player);
          this.configurePlayerContextMenu(player);
          player.on("loadedmetadata", () => {
            player.play().then(() => this.jumpToUrlTimeParameter(player)).catch(() => $('#mtp-video-overlay').removeClass('hidden-elem'));
          });
          player.on("playing", () => $('#mtp-video-overlay').remove());
          $('#big-play-button-poster-container').click(async () => {
            $('#mtp-video-overlay').remove();
            player.play().then(() => this.jumpToUrlTimeParameter(player)).catch(() => {});
          });
        }

        configurePlayerButtons(player, adaptiveSources, progressiveSources, sourcesFormatsAndResolutions, isStreaming) {
          const handleTechClickDefaultFunction = player.player_.handleTechClick_;

          const MATERIAL_NAVIGATE_NEXT_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M504-480 320-664l56-56 240 240-240 240-56 56 184-184Z" fill="#fff"/></svg>';
          const MATERIAL_NAVIGATE_BEFORE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z" fill="#fff"/></svg>';
          const MATERIAL_DONE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z" fill="#fff"/></svg>';

          if (isStreaming) {
            let isShowingStreamerMode = false;
            const streamerModeButton = player.getChild('ControlBar').addChild('button', {
              clickHandler: function (event) {
                event[0].stopPropagation();
                if (isShowingStreamerMode) {
                  isShowingStreamerMode = false;
                  streamerModeButton.el().innerHTML = '<svg width="20" height="20" fill="#fff" class="bi bi-aspect-ratio" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h13A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 12.5zM1.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5z"/><path d="M2 4.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1H3v2.5a.5.5 0 0 1-1 0zm12 7a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1 0-1H13V8.5a.5.5 0 0 1 1 0z"/></svg>';
                  $('#main-container').removeClass('w-100');
                } else {
                  isShowingStreamerMode = true;
                  streamerModeButton.el().innerHTML = '<svg width="20" height="20" fill="#fff" class="bi bi-aspect-ratio" viewBox="0 0 16 16"><path d="M0 12.5v-9A1.5 1.5 0 0 1 1.5 2h13A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 12.5M2.5 4a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 1 0V5h2.5a.5.5 0 0 0 0-1zm11 8a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-1 0V11h-2.5a.5.5 0 0 0 0 1z"/></svg>';
                  $('#main-container').addClass('w-100');
                }
              }
            });
            streamerModeButton.el().classList.add('video-js-streamer-button');
            streamerModeButton.el().innerHTML = '<svg width="20" height="20" fill="#fff" class="bi bi-aspect-ratio" viewBox="0 0 16 16"><path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h13A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 12.5zM1.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5z"/><path d="M2 4.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1H3v2.5a.5.5 0 0 1-1 0zm12 7a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1 0-1H13V8.5a.5.5 0 0 1 1 0z"/></svg>';
            streamerModeButton.el().style.cursor = "pointer";
          }

          let isShowingTheaterMode = false;
          const theaterModeButton = player.getChild('ControlBar').addChild('button', {
            clickHandler: function (event) {
              event[0].stopPropagation();
              const videoPlayerContainer = $('#video-player-container');
              const videoPlayer = $('#video-player');
              if (isShowingTheaterMode) {
                isShowingTheaterMode = false;
                theaterModeButton.el().innerHTML = '<svg height="100%" version="1.1" viewBox="0 0 36 36" width="100%"><path d="m 28,11 0,14 -20,0 0,-14 z m -18,2 16,0 0,10 -16,0 0,-10 z" fill="#fff" fill-rule="evenodd"></path></svg>';
                $(videoPlayerContainer).addClass('ratio').removeClass('position-relative');
                $(videoPlayer).removeClass('video-player-theater-mode').removeClass('vjs-fluid');
                $(videoPlayerContainer).prependTo("#video-comments-inner");
              } else {
                isShowingTheaterMode = true;
                theaterModeButton.el().innerHTML = '<svg height="100%" version="1.1" viewBox="0 0 36 36" width="100%"><path d="m 26,13 0,10 -16,0 0,-10 z m -14,2 12,0 0,6 -12,0 0,-6 z" fill="#fff" fill-rule="evenodd"></path></svg>';
                $(videoPlayerContainer).removeClass('ratio').addClass('position-relative');
                $(videoPlayer).addClass('video-player-theater-mode').addClass('vjs-fluid');
                $(videoPlayerContainer).appendTo("#theater-container");
              }
            }
          });
          theaterModeButton.el().classList.add('video-js-theater-button');
          theaterModeButton.el().innerHTML = '<svg height="100%" version="1.1" viewBox="0 0 36 36" width="100%"><path d="m 28,11 0,14 -20,0 0,-14 z m -18,2 16,0 0,10 -16,0 0,-10 z" fill="#fff" fill-rule="evenodd"></path></svg>';
          theaterModeButton.el().style.cursor = "pointer";
          this.THEATER_MODE_BUTTON = theaterModeButton;

          const overflowButton = player.getChild('ControlBar').addChild('button', {
            clickHandler: (event) => {
              event[0].stopPropagation();
              if ($('#video-player .vjs-control-bar .video-js-overflow-menu').length === 0) {
                player.player_.handleTechClick_ = function (event) { }
                $('body').on('click', function (event) {
                  $('body').off('click');
                  $('.video-player .vjs-control-bar .video-js-overflow-menu').remove();
                  player.player_.handleTechClick_ = handleTechClickDefaultFunction;
                });
                this.showVideoJsOverflowMenuHtml(player, adaptiveSources, progressiveSources, sourcesFormatsAndResolutions);
              } else {
                this.removeOverflowMenuHtml();
                player.player_.handleTechClick_ = handleTechClickDefaultFunction;
              }
            }
          });
          overflowButton.el().innerHTML = '<svg height="24" viewBox="0 -960 960 960" width="100%"><path d="M480-160q-33 0-56.5-23.5T400-240q0-33 23.5-56.5T480-320q33 0 56.5 23.5T560-240q0 33-23.5 56.5T480-160Zm0-240q-33 0-56.5-23.5T400-480q0-33 23.5-56.5T480-560q33 0 56.5 23.5T560-480q0 33-23.5 56.5T480-400Zm0-240q-33 0-56.5-23.5T400-720q0-33 23.5-56.5T480-800q33 0 56.5 23.5T560-720q0 33-23.5 56.5T480-640Z" fill="#fff"/></svg>';
          overflowButton.el().style.order = "10";
          overflowButton.el().style.cursor = "pointer";
        }

        showVideoJsOverflowMenuHtml(player, adaptiveSources, progressiveSources, sourcesFormatsAndResolutions) {
          const MATERIAL_NAVIGATE_NEXT_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z" fill="#fff"/></svg>';
          const MATERIAL_NAVIGATE_BEFORE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z" fill="#fff"/></svg>';
          const MATERIAL_DONE_SVG = '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z" fill="#fff"/></svg>';

          const currentPlaybackRate = player.playbackRate();

          player.on(["playing"], function (e) {
            // can only set a playback rate when the player is actually playing; setting before "playing" has no effect
            player.playbackRate(currentPlaybackRate);
          });

          // Combine adaptive and progressive sources
          const sources = [...adaptiveSources, ...progressiveSources];

          if (this.CURRENT_VIDEO_RESOLUTION == null && this.CURRENT_VIDEO_FORMAT == null) {
            const currentSource = player.currentSrc();
            const segments = currentSource.split('/');

            this.CURRENT_VIDEO_RESOLUTION = segments[segments.length - 1];
            this.CURRENT_VIDEO_FORMAT = segments[segments.length - 2];

            if (this.CURRENT_VIDEO_FORMAT !== 'mp4' && this.CURRENT_VIDEO_FORMAT !== 'webm' && this.CURRENT_VIDEO_FORMAT !== 'ogv') {
              this.CURRENT_VIDEO_FORMAT = 'm3u8';
              this.CURRENT_VIDEO_RESOLUTION = 'auto';
            }
          }

          this.showOverflowMenuMain(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources);
        }

        showOverflowMenuMain(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources) {
          const html = '\
            <div class="video-js-overflow-menu">\
              <button type="button" class="video-js-overflow-format-button"><label class="video-js-overflow-button-label"><span>Quality</span><span class="video-js-current-selection-span">' + this.CURRENT_VIDEO_FORMAT + ' ' + this.CURRENT_VIDEO_RESOLUTION + MATERIAL_NAVIGATE_NEXT_SVG + '</span></label></button>\
              <button type="button" class="video-js-overflow-playback-speed-button"><label class="video-js-overflow-button-label"><span>Playback speed</span><span class="video-js-current-selection-span">' + currentPlaybackRate + 'x' + MATERIAL_NAVIGATE_NEXT_SVG + '</span></label></button>\
            </div>';

          if ($("#video-player .vjs-control-bar .video-js-overflow-menu").length) {
            $("#video-player .vjs-control-bar .video-js-overflow-menu").replaceWith(html);
          }
          else {
            $("#video-player .vjs-control-bar").append(html);
          }

          $('#video-player .vjs-control-bar .video-js-overflow-menu .video-js-overflow-format-button').click((event) => {
            event.stopPropagation();

            this.showOverflowMenuFormats(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources);
          });

          $('#video-player .vjs-control-bar .video-js-overflow-menu .video-js-overflow-playback-speed-button').click((event) => {
            event.stopPropagation();

            this.showPlayRateMenu(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources);
          });
        }

        showOverflowMenuFormats(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources) {
          // find the (available) formats that actually have sources; not empty array
          const availableFormats = Object.keys(sourcesFormatsAndResolutions).filter(key => Array.isArray(sourcesFormatsAndResolutions[key]) && sourcesFormatsAndResolutions[key].length > 0);

          let html = '<div class="video-js-overflow-menu">\
            <button type="button" class="video-js-back-to-overflow-main-button"><span>Format</span>' + MATERIAL_NAVIGATE_BEFORE_SVG + '</button>';

          availableFormats.forEach((availableFormat) => {
            if (this.CURRENT_VIDEO_FORMAT === availableFormat) {
              html += '<button type="button" class="video-js-overflow-format-explicit-button video-js-overflow-explicit-selected-button" data-format="' + availableFormat + '"><span class="video-js-chosen-item">' + MATERIAL_DONE_SVG + '</span><span>' + availableFormat + '</span></button>';
            }
            else {
              html += '<button type="button" class="video-js-overflow-format-explicit-button" data-format="' + availableFormat + '"><span class="video-js-chosen-item hidden-elem">' + MATERIAL_DONE_SVG + '</span><span>' + availableFormat + '</span></button>';
            }
          });

          html += '</div>';

          $("#video-player .vjs-control-bar .video-js-overflow-menu").replaceWith(html);

          $('#video-player .vjs-control-bar .video-js-overflow-menu .video-js-overflow-format-explicit-button').click((event) => {
            event.stopPropagation();

            const selectedVideoFormat = $(event.target).closest('button').data('format');

            this.showOverflowMenuResolutions(player, sourcesFormatsAndResolutions, selectedVideoFormat, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources);
          });

          // back from formats menu to main menu
          $('.video-js-back-to-overflow-main-button').click((event) => {
            event.stopPropagation();

            this.showOverflowMenuMain(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources);
          });
        }

        showOverflowMenuResolutions(player, sourcesFormatsAndResolutions, selectedVideoFormat, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources) {
          const resolutions = sourcesFormatsAndResolutions[selectedVideoFormat];

          let html = '<div class="video-js-overflow-menu">\
            <button type="button" class="video-js-back-to-overflow-formats-button"><span>Resolution</span>' + MATERIAL_NAVIGATE_BEFORE_SVG + '</button>';

          resolutions.forEach((resolution) => {
            if (selectedVideoFormat === this.CURRENT_VIDEO_FORMAT && this.CURRENT_VIDEO_RESOLUTION === resolution) {
              html += '<button type="button" class="video-js-overflow-format-resolution-explicit-button video-js-overflow-explicit-selected-button" data-resolution="' + resolution + '"><span class="video-js-chosen-item">' + MATERIAL_DONE_SVG + '</span><span>' + resolution + '</span></button>';
            }
            else {
              html += '<button type="button" class="video-js-overflow-format-resolution-explicit-button" data-resolution="' + resolution + '"><span class="video-js-chosen-item hidden-elem">' + MATERIAL_DONE_SVG + '</span><span>' + resolution + '</span></button>';
            }
          });

          if (selectedVideoFormat === 'm3u8') {
            if (this.CURRENT_VIDEO_RESOLUTION === 'auto') {
              html += '<button type="button" class="video-js-overflow-format-resolution-explicit-button video-js-overflow-explicit-selected-button" data-resolution="auto"><span class="video-js-chosen-item">' + MATERIAL_DONE_SVG + '</span><span>auto</span></button>';
            }
            else {
              html += '<button type="button" class="video-js-overflow-format-resolution-explicit-button" data-resolution="auto"><span class="video-js-chosen-item hidden-elem">' + MATERIAL_DONE_SVG + '</span><span>auto</span></button>';
            }
          }

          html += '</div>';

          $("#video-player .vjs-control-bar .video-js-overflow-menu").replaceWith(html);

          // back from resolutions menu to formats menu
          $('.video-js-back-to-overflow-formats-button').click((event) => {
            event.stopPropagation();

            this.showOverflowMenuFormats(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources);
          });

          $('#video-player .vjs-control-bar .video-js-overflow-menu .video-js-overflow-format-resolution-explicit-button').click((event) => {
            event.stopPropagation();

            this.CURRENT_VIDEO_FORMAT = selectedVideoFormat;
            this.CURRENT_VIDEO_RESOLUTION = $(event.target).closest('button').data('resolution');

            $('#video-player .vjs-control-bar .video-js-overflow-menu .video-js-overflow-format-resolution-explicit-button .video-js-chosen-item').addClass('hidden-elem');
            $('#video-player .vjs-control-bar .video-js-overflow-menu .video-js-overflow-format-resolution-explicit-button').removeClass('video-js-overflow-explicit-selected-button');

            $(event.target).closest('button').addClass('video-js-overflow-explicit-selected-button');
            $(event.target).closest('button').find('.video-js-chosen-item').removeClass('hidden-elem');

            let source;

            if (this.CURRENT_VIDEO_FORMAT === 'm3u8') {
              if (this.CURRENT_VIDEO_RESOLUTION === 'auto') {
                source = { src: sources[0].src, type: sources[0].type };
              }
              else {
                for (const adaptiveSource of sources) {
                  if (adaptiveSource.type !== 'application/x-mpegURL') continue;
                  const segments = adaptiveSource.src.split('/');
                  const adaptiveSourceResolution = segments[segments.length - 1];

                  if (adaptiveSourceResolution === ('manifest-' + this.CURRENT_VIDEO_RESOLUTION + '.' + this.CURRENT_VIDEO_FORMAT)) {
                    source = { src: adaptiveSource.src, type: adaptiveSource.type };
                  }
                }
              }
            }
            else {
              for (const progressiveSource of sources) {
                if (progressiveSource.type === 'application/x-mpegURL') continue;
                const segments = progressiveSource.src.split('/');

                const progressiveSourceResolution = segments[segments.length - 1];
                const progressiveSourceFormat = segments[segments.length - 2];

                if (this.CURRENT_VIDEO_RESOLUTION === progressiveSourceResolution.split('.')[0] && this.CURRENT_VIDEO_FORMAT === progressiveSourceFormat) {
                  source = { src: progressiveSource.src, type: progressiveSource.type };
                }
              }
            }

            const currentTime = player.currentTime();

            player.src(source);
            player.currentTime(currentTime);

            player.play()
              .then(function () {
                // do nothing
              })
              .catch(function (error) {
                console.log(error);
              });
          });
        }

        showPlayRateMenu(player, sourcesFormatsAndResolutions, currentPlaybackRate, MATERIAL_NAVIGATE_NEXT_SVG, MATERIAL_NAVIGATE_BEFORE_SVG, MATERIAL_DONE_SVG, sources) {
          const playbackRates = [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0];

          let html = '<div class="video-js-overflow-menu">\
            <button type="button" class="video-js-back-to-overflow-main-button"><span>Playback speed</span>' + MATERIAL_NAVIGATE_BEFORE_SVG + '</button>';

