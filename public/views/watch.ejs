        jumpToUrlTimeParameter(player) {
          if (this.TIME_PARAMETER != null) player.currentTime(this.TIME_PARAMETER);
        }

        connectWebsocket() {
          let connectWebsocketClient = () => {
            try {
              let LIVE_CHAT_USERNAME;
              let LIVE_CHAT_USERNAME_COLOR_CODE;
              $('#live-stream-chat-container').removeClass('hidden-elem');
              const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
              const hostname = window.location.hostname;
              const port = window.location.port;
              let ws = new WebSocket(protocol + '//' + hostname + ':' + port);
              ws.onopen = () => {
                ws.send(JSON.stringify({ eventName: 'register', socketType: 'node_peer' }));
              };
              ws.onclose = () => {
                setTimeout(() => {
                  connectWebsocketClient();
                }, 3000);
              };
              ws.onmessage = (message) => {
                const data = JSON.parse(message.data);
                if (data.eventName === 'registered') {
                  ws.send(JSON.stringify({ eventName: 'chat', type: 'join', videoId: this.VIDEO_ID }));
                } else if (data.eventName === 'joined') {
                  LIVE_CHAT_USERNAME = data.liveChatUsername;
                  LIVE_CHAT_USERNAME_COLOR_CODE = data.liveChatUsernameColorCode;
                  $('#send-chat-message-input').prop('placeholder', 'Type your message');
                  $('#send-chat-message-input').prop('disabled', false);
                  $('#send-chat-message-button').prop('disabled', false);
                  $('#send-chat-message-button').off('click').on('click', (event) => {
                    this.broadcastChatMessageContent(ws, LIVE_CHAT_USERNAME, LIVE_CHAT_USERNAME_COLOR_CODE);
                  });
                  $('#send-chat-message-input').off('keypress').on('keypress', (event) => {
                    if (event.keyCode === 13) {
                      this.broadcastChatMessageContent(ws, LIVE_CHAT_USERNAME, LIVE_CHAT_USERNAME_COLOR_CODE);
                    }
                  });
                  $.ajax({ type: 'GET', url: '/streams/' + this.VIDEO_ID + '/chat/history' })
                    .done((data) => {
                      if (data.isError) {
                        console.log(data.message);
                      } else {
                        const chatHistory = data.chatHistory;
                        $("#chat-messages").empty();
                        for (const chatMessage of chatHistory) {
                          const chatMessageContent = chatMessage.chat_message;
                          const liveChatUsername = chatMessage.username;
                          const liveChatUsernameColorCode = chatMessage.username_color_hex_code;
                          this.appendMessageAndConditionallyScroll(chatMessageContent, liveChatUsername, liveChatUsernameColorCode, null, true);
                        }
                      }
                    })
                    .fail(function () {
                      console.log('unable to communicate with node');
                    });
                } else if (data.eventName === 'message') {
                  const chatMessageContent = data.chatMessageContent;
                  const liveChatUsername = data.liveChatUsername;
                  const liveChatUsernameColorCode = data.liveChatUsernameColorCode;
                  const sentTimestamp = data.sentTimestamp;
                  if (liveChatUsername !== LIVE_CHAT_USERNAME && liveChatUsernameColorCode !== LIVE_CHAT_USERNAME_COLOR_CODE) {
                    this.appendMessageAndConditionallyScroll(chatMessageContent, liveChatUsername, liveChatUsernameColorCode, null, false);
                  } else if (liveChatUsername === LIVE_CHAT_USERNAME && liveChatUsernameColorCode === LIVE_CHAT_USERNAME_COLOR_CODE) {
                    const chatMessageElementId = `${liveChatUsername}-${liveChatUsernameColorCode}-${sentTimestamp}`;
                    $('#' + chatMessageElementId).removeClass('pending-chat-message');
                  }
                } else if (data.eventName === 'live_stream_stats') {
                  const watchingCount = data.watchingCount;
                  $('#video-information-views').text(watchingCount + ' watching now');
                } else if (data.eventName === 'limited') {
                  let rateLimitSeconds = data.rateLimitSeconds;
                  $('#send-chat-message-input').prop('disabled', true);
                  $('#send-chat-message-button').prop('disabled', true);
                  $('#send-chat-message-button').text('Send (' + rateLimitSeconds + ')');
                  const interval = setInterval(function () {
                    rateLimitSeconds--;
                    $('#send-chat-message-button').text('Send (' + rateLimitSeconds + ')');
                    if (rateLimitSeconds === 0) {
                      clearInterval(interval);
                      $('#send-chat-message-button').text('Send');
                      $('#send-chat-message-input').prop('disabled', false);
                      $('#send-chat-message-button').prop('disabled', false);
                    }
                  }, 1000);
                } else if (data.eventName === 'error') {
                  const errorType = data.errorType;
                  if (errorType === 'register') {
                    $('#send-chat-message-input').prop('disabled', true);
                    $('#send-chat-message-button').prop('disabled', true);
                  } else if (errorType === 'join') {
                    $('#send-chat-message-input').prop('disabled', true);
                    $('#send-chat-message-button').prop('disabled', true);
                  } else if (errorType === 'message') {
                    const liveChatUsername = data.liveChatUsername;
                    const liveChatUsernameColorCode = data.liveChatUsernameColorCode;
                    const sentTimestamp = data.sentTimestamp;
                    const chatMessageElementId = `${liveChatUsername}-${liveChatUsernameColorCode}-${sentTimestamp}`;
                    $('#' + chatMessageElementId).remove();
                    $('#send-chat-message-input').prop('disabled', false);
                    $('#send-chat-message-button').prop('disabled', false);
                    $('#send-chat-message-button').text('Send');
                  }
                  this.showAlert(true, data.message);
                } else if (data.eventName === 'cloudflare_turnstile_information') {
                  const cloudflareTurnstileSiteKey = data.data.cloudflareTurnstileSiteKey;
                  this.CLOUDFLARE_TURNSTILE_SITE_KEY = cloudflareTurnstileSiteKey;
                }
              };
            } catch (error) {}
          };
          connectWebsocketClient();
        }

        appendMessageAndConditionallyScroll(chatMessageContent, liveChatUsername, liveChatUsernameColorCode, sentTimestamp, forceScrollBottom) {
          const chatMessagesContainer = $("#chat-messages-container");
          const chatMessages = $("#chat-messages");
          const chatMessageElement = $('<div class="chat-message pb-2"><div class="flex-shrink-1 rounded px-2"><b style="color:#' + liveChatUsernameColorCode + ';font-size:0.8em;">' + liveChatUsername + '</b>: <span class="live-chat-text-color">' + chatMessageContent + '</span></div></div>');
          if (sentTimestamp != null) {
            const chatMessageElementId = `${liveChatUsername}-${liveChatUsernameColorCode}-${sentTimestamp}`;
            $(chatMessageElement).attr('id', chatMessageElementId);
            $(chatMessageElement).addClass('pending-chat-message');
          }
          const scrollheight = $(chatMessagesContainer)[0].scrollHeight;
          const scrollTop = $(chatMessagesContainer).scrollTop();
          const outerheight = $(chatMessagesContainer).outerHeight();
          const isScrolledBottom = (scrollheight - scrollTop - outerheight) <= 100;
          $(chatMessages).append(chatMessageElement);
          if (isScrolledBottom || forceScrollBottom) {
            $(chatMessagesContainer).scrollTop(scrollheight);
          }
          return chatMessageElement;
        }

        broadcastChatMessageContent(ws, liveChatUsername, liveChatUsernameColorCode) {
          if (ws.readyState === WebSocket.OPEN) {
            const chatMessageContent = $('#send-chat-message-input').val();

            if (chatMessageContent.length > 0) {
              $('#send-chat-message-input').val('');

              const sentTimestamp = Date.now();

              const chatMessageElement = this.appendMessageAndConditionallyScroll(
                chatMessageContent,
                liveChatUsername,
                liveChatUsernameColorCode,
                sentTimestamp,
                true
              );

              this.getCloudflareTurnstileToken()
                .then((cloudflareTurnstileToken) => {
                  ws.send(
                    JSON.stringify({
                      eventName: 'chat',
                      type: 'message',
                      videoId: this.VIDEO_ID,
                      chatMessageContent: chatMessageContent,
                      sentTimestamp: sentTimestamp,
                      cloudflareTurnstileToken: cloudflareTurnstileToken,
                    })
                  );
                })
                .catch((error) => {
                  this.showAlert(true, error);
                  $(chatMessageElement).remove();
                });
            }
          }
        }

        handleCommentSubmit(event, form) {
          event.preventDefault();
          const commentFormType = $(form).data('commentformtype');
          const commentPlainText = $(form).find('textarea[name="commentPlainText"]').val();
          if (commentPlainText !== '') {
            this.disableFormInputs($(form), '...please wait...');
            this.getCloudflareTurnstileToken().then(cloudflareTurnstileToken => {
              $.ajax({
                type: 'POST',
                url: '/videos/' + this.VIDEO_ID + '/comments/comment',
                data: JSON.stringify({ commentPlainText: commentPlainText, timestamp: this.MOST_RECENT_VISIBLE_COMMENT_TIMESTAMP, cloudflareTurnstileToken: cloudflareTurnstileToken }),
                contentType: 'application/json; charset=utf-8',
              })
                .done(data => {
                  if (data.isError) {
                    this.showAlert(true, data.message);
                  } else {
                    if (commentFormType === 'dynamic') {
                      $(form).remove();
                    } else if (commentFormType === 'static') {
                      $(form).find('textarea[name="commentPlainText"]').val('');
                    }
                    const commentId = data.commentId;
                    const comments = data.comments;
                    this.loadComments(comments, true);
                  }
                  this.enableFormInputs($(form), 'submit');
                })
                .fail(() => {
                  this.showAlert(true, 'unable to submit comment, please try again later');
                  this.enableFormInputs($(form), 'submit');
                });
            }).catch(error => {
              console.log(error);
              this.showAlert(true, 'Human verification failed. Please try again.');
              this.enableFormInputs($(form), 'submit');
            });
          }
        }

        disableFormInputs(form, buttonText) {
          form.find(':submit').prop('disabled', true);
          form.find('textarea[name="commentPlainText"]').prop('disabled', true);
          form.find(':submit').html(buttonText);
        }

        enableFormInputs(form, buttonText) {
          form.find(':submit').prop('disabled', false);
          form.find('textarea[name="commentPlainText"]').prop('disabled', false);
          form.find(':submit').html(buttonText);
        }

        loadComments(comments, highlight) {
          const commentsContainer = $('#comments-container');
          commentsContainer.find('.post.reply').removeClass('new-comment-highlight');
          if (comments.length > 0) {
            $('.comments-navigation-button').removeClass('hidden-elem');
            const commentSectionCounter = $('#comment-section-counter');
            const commentSectionCounterDescriptor = $('#comment-section-counter-descriptor');
            const expandCommentSectionCounter = $('#expand-comment-section-counter');
            const expandCommentSectionCounterDescriptor = $('#expand-comment-section-counter-descriptor');
            commentSectionCounter.text(parseInt($(commentSectionCounter).text()) + comments.length);
            expandCommentSectionCounter.text(parseInt($(expandCommentSectionCounter).text()) + comments.length);
            if (parseInt($(commentSectionCounter).text()) === 1) {
              commentSectionCounterDescriptor.text('Comment');
            } else {
              commentSectionCounterDescriptor.text('Comments');
            }
            if (parseInt($(expandCommentSectionCounter).text()) === 1) {
              expandCommentSectionCounterDescriptor.html('Comment');
            } else {
              expandCommentSectionCounterDescriptor.html('Comments');
            }
            comments.forEach((comment) => {
              const commentId = comment.commentId;
              const commentPlainTextSanitized = comment.commentPlainTextSanitized;
              const timestamp = comment.timestamp;
              if (timestamp > this.MOST_RECENT_VISIBLE_COMMENT_TIMESTAMP) {
                this.MOST_RECENT_VISIBLE_COMMENT_TIMESTAMP = timestamp;
              }
              const formattedDate = this.getCreationTimestampFormatted(timestamp);
              const commentTextHtml = this.convertCommentToHTML(commentPlainTextSanitized);
              const replyToCommentIds = this.extractReplyToCommentIds(commentPlainTextSanitized);
              const commentElement = this.generateCommentElement(commentId, timestamp, formattedDate, commentTextHtml, highlight);
              this.COMMENT_ELEMENT_CACHE[commentId] = commentElement;
              for (const replyToCommentId of replyToCommentIds) {
                if (this.COMMENT_ELEMENT_CACHE.hasOwnProperty(replyToCommentId)) {
                  $(this.COMMENT_ELEMENT_CACHE[replyToCommentId]).find('#bl_' + replyToCommentId).append('<a href="#p' + commentId + '" class="quotelink">&gt;&gt;' + commentId + '</a> ');
                  this.attachQuotelinkListeners(this.COMMENT_ELEMENT_CACHE[replyToCommentId]);
                }
              }
              $(commentsContainer).prepend(commentElement);
              this.attachQuotelinkListeners(commentElement);
            });
          }
        }

        generateCommentElement(commentId, timestamp, formattedDate, commentTextHtml, highlight) {
          const commentElement = $(
            '<div class="postContainer replyContainer" id="pc' + commentId + '" data-timestamp="' + timestamp + '">\
              <div id="p' + commentId + '" class="post reply">\
                <div class="postInfoM mobile" id="pim' + commentId + '">\
                  <span class="nameBlock">\
                    <span class="name">Anonymous</span>\
                    <br>\
                  </span>\
                  <span class="dateTime postNum">(' + formattedDate + ')\
                    <a href="#p' + commentId + '" title="Link to this post">No.</a>\
                    <a class="quotelink" data-comment-id="' + commentId + '" title="Reply to this post">' + commentId + '</a>\
                  </span>\
                </div>\
                <div class="postInfo desktop" id="pi' + commentId + '">\
                  <span class="nameBlock">\
                    <span class="name">Anonymous</span>\
                  </span>\
                  <span class="dateTime">(' + formattedDate + ')</span>\
                  <span class="postNum desktop">\
                    <a class="tests" href="#p' + commentId + '" title="Link to this post">No.</a>\
                    <a class="quotelink" data-comment-id="' + commentId + '" title="Reply to this post">' + commentId + '</a>\
                  </span>\
                  <a class="postMenuBtn" title="Post menu" role="button" data-cmd="post-menu" data-bs-toggle="dropdown" aria-expanded="false" id="comment-' + commentId + '-dropdown-button">&#x25B6;</a>\
                  <ul class="dropdown-menu" aria-labelledby="comment-' + commentId + '-dropdown-button"><li><a class="dropdown-item comment-report-button" role="button" data-comment-id="' + commentId + '" data-timestamp="' + timestamp + '">Report</a></li></ul>\
                  <div id="bl_' + commentId + '" class="backlink"></div>\
                </div>\
                <blockquote class="postMessage text-break" id="m' + commentId + '">' + commentTextHtml + '</blockquote>\
              </div>\
            </div>');
          if (highlight) {
            commentElement.find('.post.reply').addClass('new-comment-highlight');
          }
          return commentElement;
        }

        convertCommentToHTML(commentPlainTextSanitized) {
          const lines = commentPlainTextSanitized.trim().split('\n');
          const html = lines.map(line => {
            const trimmedLine = line.trim();
            if (trimmedLine.startsWith('&gt;&gt;')) {
              const commentId = trimmedLine.substr(8);
              const quoteLink = '<a href="#p' + commentId + '" class="quotelink">' + trimmedLine + '</a>';
              return quoteLink;
            } else if (trimmedLine.startsWith('&gt;')) {
              const quotedText = '<span class="quote">' + trimmedLine + '</span>';
              return quotedText;
            } else {
              return trimmedLine;
            }
          }).join('<br>');
          return html;
        }

        extractReplyToCommentIds(commentPlainTextSanitized) {
          const regex = /&gt;&gt;(\d+)/g;
          const matches = [];
          let match;
          while ((match = regex.exec(commentPlainTextSanitized)) !== null) {
            matches.push(parseInt(match[1]));
          }
          return matches;
        }

        attachQuotelinkListeners(commentElement) {
          $(commentElement).find('.quotelink').mouseenter((event) => {
            const quotelink = event.target;
            const commentId = $(quotelink).text().match(/\d+/g)[0];
            const commentElement = $('#p' + commentId);
            const div = document.getElementById('pc' + commentId);
            if (div == null) {
              const quotingTimestamp = $(quotelink).closest('.postContainer').data('timestamp');
              $.ajax({ type: 'GET', url: '/videos/' + this.VIDEO_ID + '/comments/' + commentId, data: { timestamp: quotingTimestamp } })
                .done((data, textStatus, xhr) => {
                  if (data.isError) {
                    console.log(data.message);
                  } else {
                    const commentData = data.comment;
                    if (commentData == null) {
                      $(quotelink).addClass('deadlink');
                    } else {
                      const commentId = commentData.commentId;
                      const commentPlainTextSanitized = commentData.commentPlainTextSanitized;
                      const timestamp = commentData.timestamp;
                      const formattedDate = this.getCreationTimestampFormatted(timestamp);
                      const commentTextHtml = this.convertCommentToHTML(commentPlainTextSanitized);
                      const commentElement = this.generateCommentElement(commentId, timestamp, formattedDate, commentTextHtml, false)[0];
                      this.showQuotePreview(commentElement, quotelink);
                    }
                  }
                })
                .fail(function () {
                  console.log('unable to communicate with node');
                });
            } else {
              const divOffset = div.getBoundingClientRect();
              const divHeight = div.offsetHeight;
              const windowHeight = window.innerHeight || document.documentElement.clientHeight;
              const topLeftCornerAboveScreen = divOffset.top < 0;
              const topRightCornerAboveScreen = (divOffset.top < 0) && ((divOffset.left + div.offsetWidth) > window.innerWidth || document.documentElement.clientWidth);
              const bottomLeftCornerBelowScreen = (divOffset.top + divHeight) > windowHeight;
              const bottomRightCornerBelowScreen = ((divOffset.top + divHeight) > windowHeight) && ((divOffset.left + div.offsetWidth) > window.innerWidth || document.documentElement.clientWidth);
              if (topLeftCornerAboveScreen || topRightCornerAboveScreen || bottomLeftCornerBelowScreen || bottomRightCornerBelowScreen) {
                const clonedElement = div.cloneNode(true);
                this.showQuotePreview(clonedElement, quotelink);
              } else {
                if (commentElement.length) {
                  if (commentElement.is(':target')) {
                    $(commentElement).addClass('highlight-anti');
                  } else {
                    $(commentElement).addClass('highlight');
                  }
                } else {
                  $(quotelink).addClass('deadlink');
                }
              }
            }
          });
          $(commentElement).find('.quotelink').mouseleave(function () {
            $('#quote-preview').remove();
            const commentId = $(this).text().match(/\d+/g)[0];
            const comment = $('#p' + commentId);
            if (comment.is(':target')) {
              $(comment).removeClass('highlight-anti');
            } else {
              $(comment).removeClass('highlight');
            }
          });
          $(commentElement).find('.quotelink').click((event) => {
            $('#quote-preview').remove();
            const commentId = $(event.target).text().match(/\d+/g)[0];
            const comment = $('#p' + commentId);
            this.HASH_VALUE = '#p' + commentId;
            $('.post').removeClass('highlight');
            if (comment.is(':target')) {
              $(comment).removeClass('highlight-anti');
            } else {
              $(comment).removeClass('highlight');
            }
          });
        }

        showQuotePreview(quotePreview, quotelink) {
          quotePreview.id = 'quote-preview';
          const targetElement = quotePreview.querySelector('.post.reply');
          if (targetElement != null) {
            targetElement.classList.remove('highlight-anti');
            targetElement.classList.add('highlight');
          }
          $('#quote-preview').remove();
          $('body').append(quotePreview);
          const quotelinkWidth = quotelink.offsetWidth;
          const quotelinkHeight = quotelink.offsetHeight;
          const targetElementHeight = quotePreview.offsetHeight;
          const scrollY = window.pageYOffset || document.documentElement.scrollTop;
          quotePreview.style.position = 'absolute';
          quotePreview.style.left = quotelink.getBoundingClientRect().left + quotelinkWidth + 5;
          quotePreview.style.top = scrollY + quotelink.getBoundingClientRect().top - (targetElementHeight / 2) + (quotelinkHeight / 2);
        }

        updateComments() {
          $('#update-comments-button').addClass('hidden-elem');
          $('#update-comments-button-spinner').removeClass('hidden-elem');
          const previousCommentCount = parseInt($('#comment-section-counter').text());
          $.ajax({ type: 'GET', url: '/videos/' + this.VIDEO_ID + '/comments', data: { timestamp: this.MOST_RECENT_VISIBLE_COMMENT_TIMESTAMP, type: 'after', sort: 'ascending' } })
            .done(data => {
              if (data.isError) {
                console.log(data.message);
              } else {
                const comments = data.comments;
                this.loadComments(comments, true);
                const newCommentCount = parseInt($('#comment-section-counter').text());
                $('#update-comments-button').removeClass('hidden-elem');
                $('#update-comments-button-spinner').addClass('hidden-elem');
                let commentCountDifference = newCommentCount - previousCommentCount;
                if (commentCountDifference === 1) {
                  $('#comment-section-update-descriptor').text('1 new comment');
                } else {
                  $('#comment-section-update-descriptor').text(commentCountDifference + ' new comments');
