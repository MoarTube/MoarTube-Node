              $('#darkModeSwitch').prop('checked', true);
              this.IS_DARK_MODE_ENABLED = true;
            } else {
              $('#darkModeSwitch').prop('checked', false);
              this.IS_DARK_MODE_ENABLED = false;
            }

            $('#darkModeSwitch').off('change');
            $('#darkModeSwitch').change(async () => {
              this.IS_DARK_MODE_ENABLED = $('#darkModeSwitch').prop('checked');

              if (this.IS_DARK_MODE_ENABLED) {
                $('#dark-mode-style').prop('disabled', false);
              } else {
                $('#dark-mode-style').prop('disabled', true);
              }

