# MoarTube Node Environment Configuration

# Application environment (development, production)
NODE_ENV=development

# Sets the node's data directory.
# If NODE_ENV is development, then the data directory is in the current workspace.
# If NODE_ENV is production or is absent (which implies production), then the data directory is %APPDATA%\moartube-node.
# Or you can set MOARTUBE_DATA_DIR to whatever you want.
# MOARTUBE_DATA_DIR=

# Set to 'true' when running inside Docker container
IS_DOCKER_ENVIRONMENT=false

# The amount of workers to run (unset or 0 uses all logical CPUs)
MOARTUBE_WORKERS=4
