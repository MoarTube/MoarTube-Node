{
  "name": "@moartube/moartube-node",
  "version": "1.1.0",
  "type": "module",
  "description": "A free, open-source, self-hosted, anonymous, decentralized video/live stream platform. Scalable via Cloudflare, works in the cloud or from home WiFi.",
  "author": "MoarTube, LLC",
  "homepage": "https://www.moartube.com",
  "license": "Custom License - See LICENSE.md file",
  "main": "dist/moartube-node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoarTube/MoarTube-Node.git"
  },
  "bin": {
    "moartube-node": "./bin/moartube-node-start"
  },
  "keywords": [
    "alternative",
    "youtube",
    "twitch",
    "video",
    "stream",
    "live",
    "moartube"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "scripts": {
    "dev": "tsx watch src/moartube-node.ts",
    "build": "tsup",
    "start": "node dist/moartube-node.js",
    "dev:start": "tsx src/moartube-node.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:src": "eslint src --ext .ts",
    "lint:tests": "eslint tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "prepare": "husky install",
    "db:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.967.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@fastify/view": "^11.1.1",
    "@types/ejs": "^3.1.5",
    "async-mutex": "^0.5.0",
    "awilix": "^12.0.5",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "ejs": "^3.1.10",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "http-terminator": "^3.2.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.8",
    "sanitize-html": "^2.17.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/sanitize-html": "^2.16.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.17",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.80.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17"
  }
}
