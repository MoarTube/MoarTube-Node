{
  "name": "@moartube/moartube-node",
  "version": "1.0.49",
  "description": "A free, open-source, self-hosted, anonymous, decentralized video/live stream platform. Scalable via Cloudflare, works in the cloud or from home WiFi.",
  "author": "MoarTube, LLC",
  "homepage": "https://www.moartube.com",
  "license": "Custom License - See LICENSE.md file",
  "main": "moartube-node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoarTube/MoarTube-Node.git"
  },
  "bin": {
    "moartube-node": "./bin/moartube-node-start"
  },
  "keywords": [
    "alternative",
    "youtube",
    "twitch",
    "video",
    "stream",
    "live",
    "moartube"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:legacy": "node moartube-node.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.1",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.9.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.0",
    "express-dot-engine": "^1.0.8",
    "express-session": "^1.18.0",
    "express-subdomain": "^1.0.6",
    "http-terminator": "^3.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "postgres": "^3.4.7",
    "sanitize-html": "^2.13.1",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.1",
    "drizzle-kit": "^0.31.3",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
