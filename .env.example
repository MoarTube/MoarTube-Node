# MoarTube Node Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================
# General Settings
# ============================================

# Application environment (development, production, test)
NODE_ENV=production

# Set to 'true' when running inside Docker container
IS_DOCKER_ENVIRONMENT=false

# Custom data directory path (optional - defaults to platform-specific location)
# Linux: ~/.local/share/moartube-node
# macOS: ~/Library/Preferences/moartube-node
# Windows: %APPDATA%/moartube-node
# MOARTUBE_DATA_DIR=/path/to/data

# ============================================
# Server Settings
# ============================================

# HTTP server port
PORT=8181

# HTTP server host (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Enable HTTPS (requires certificates in data/certificates/)
HTTPS_ENABLED=false

# ============================================
# Database Settings
# ============================================

# Database type: sqlite or postgres
DATABASE_TYPE=sqlite

# PostgreSQL connection URL (only used when DATABASE_TYPE=postgres)
# DATABASE_URL=postgres://user:password@localhost:5432/moartube

# ============================================
# Indexer Service Settings
# ============================================

# MoarTube Indexer URL (for video discovery/search)
INDEXER_HTTP_PROTOCOL=https
INDEXER_HOST=indexer.moartube.com
INDEXER_PORT=443

# ============================================
# Aliaser Service Settings
# ============================================

# MoarTube Aliaser URL (for node aliases)
ALIASER_HTTP_PROTOCOL=https
ALIASER_HOST=aliaser.moartube.com
ALIASER_PORT=443

# ============================================
# Cloudflare Settings (Optional)
# ============================================

# Enable Cloudflare integration for CDN/scaling
# CLOUDFLARE_ENABLED=false
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# ============================================
# S3 Storage Settings (Optional)
# ============================================

# Enable S3-compatible storage for media files
# S3_ENABLED=false
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ============================================
# Developer Settings
# ============================================

# Enable developer mode (additional logging, relaxed security)
DEVELOPER_MODE=false

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info
