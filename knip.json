{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/moartube-node.ts"
  ],
  "project": [
    "src/**/*.{ts,js}"
  ],
  "ignore": [
    "**/*.d.ts",
    "**/*.config.*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "dist/**",
    "node_modules/**",
    "public/**",
    "data/**",
    "drizzle/**",
    "coverage/**"
  ],
  "ignoreDependencies": [
    "@types/*",
    "tsx",
    "drizzle-kit",
    "@fastify/jwt",
    "async-mutex",
    "http-terminator"
  ],
  "ignoreBinaries": [
    "husky",
    "lint-staged"
  ],
  "ignoreExportsUsedInFile": true
}